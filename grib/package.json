{
  "name": "@azohra/meteo.grib",
  "version": "0.1.2",
  "description": "The GRIB2 decoder of meteo by Azohra: pure TypeScript section parsing, multi-field messages, grid geometry with O(1) nearest-gridpoint lookup (regular, rotated, and Lambert conformal grids), simple and complex packing, JPEG 2000 via an injected decoder, and NOMADS .idx ranged-fetch helpers. Validated bit-for-bit against ecCodes golden fixtures.",
  "keywords": [
    "grib",
    "grib2",
    "weather",
    "meteorology",
    "decoder",
    "eccc",
    "noaa"
  ],
  "author": "Justin Watts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/azohra/meteo.git",
    "directory": "grib"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./j2k-node": {
      "types": "./dist/j2k-node.d.ts",
      "default": "./dist/j2k-node.js"
    },
    "./j2k-worker": {
      "types": "./dist/j2k-worker.d.ts",
      "default": "./dist/j2k-worker.js"
    }
  },
  "scripts": {
    "build": "pnpm --dir ../j2k build && vp pack",
    "test": "pnpm --dir ../j2k build && vp test",
    "typecheck": "pnpm run build && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@azohra/meteo.j2k": "workspace:*",
    "@cornerstonejs/codec-openjpeg": "^1.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "homepage": "https://meteo.azohra.com"
}
