{
  "name": "@azohra/meteo.forecast",
  "version": "0.6.1",
  "description": "Forecast engine: fetches provider bytes from ECCC Datamart and NOAA Open Data, samples gridpoints, derives site forecasts, and publishes the versioned JSON documents and history archives that @azohra/meteo.briefing reads.",
  "keywords": [
    "weather",
    "forecast",
    "meteorology",
    "soaring",
    "grib2",
    "hrdps",
    "gfs",
    "hrrr",
    "cli"
  ],
  "author": "Justin Watts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/azohra/meteo.git",
    "directory": "forecast"
  },
  "type": "module",
  "bin": {
    "meteo": "./dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/internal",
    "models.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./contract": {
      "types": "./dist/scenario/contract.d.ts",
      "default": "./dist/scenario/contract.js"
    },
    "./models.json": "./models.json",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@azohra/meteo.briefing": "workspace:*",
    "@azohra/meteo.core": "workspace:*",
    "@azohra/meteo.grib": "workspace:*",
    "ajv": "^8.20.0",
    "aws4fetch": "^1.0.20",
    "geotiff": "^3.0.5",
    "h5wasm": "^0.10.3",
    "proj4": "^2.21.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  },
  "homepage": "https://meteo.azohra.com"
}
