{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meteo.azohra.com/schema/stationclimatology.schema.json",
  "title": "StationClimatology",
  "description": "The multi-year cube served at /climatology: (month, slot-of-day, sector) sums bucketed in the station's standard time, binned with the consumer's thresholds. Its own document family — it versions apart from the feed.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "servedAt": {
      "type": "string",
      "format": "date-time"
    },
    "stationId": {
      "type": "string",
      "minLength": 1
    },
    "sectorCount": {
      "type": "integer",
      "minimum": 4,
      "maximum": 9007199254740991
    },
    "slotMinutes": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "description": "Minutes per slot of day; must divide 1440."
    },
    "thresholdsMps": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 0
      },
      "description": "The consumer's speed-band bounds the cube was binned with, m/s, ascending. A judgment parameter echoed so a reader knows which opinion shaped bandCounts."
    },
    "utcOffsetMinutes": {
      "type": "number",
      "description": "The station's STANDARD utc offset used for month and slot bucketing — no DST, so a slot means the same solar hours in January and July."
    },
    "years": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ClimatologyYear"
      },
      "description": "Oldest first; the coverage ledger."
    },
    "cells": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ClimatologyCell"
      }
    }
  },
  "required": [
    "schemaVersion",
    "servedAt",
    "stationId",
    "sectorCount",
    "slotMinutes",
    "thresholdsMps",
    "utcOffsetMinutes",
    "years",
    "cells"
  ],
  "$defs": {
    "ClimatologyYear": {
      "type": "object",
      "properties": {
        "year": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "sampleCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "expectedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Records a gapless station would have produced over the requested window — the honesty denominator; a leading dropout lowers the ratio instead of hiding."
        }
      },
      "required": [
        "year",
        "sampleCount",
        "expectedCount"
      ]
    },
    "ClimatologyCell": {
      "type": "object",
      "properties": {
        "month": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "slot": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Slot of day: floor(standard-time minute / slotMinutes)."
        },
        "sampleCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "All records in the bucket, calm included."
        },
        "calmCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sectors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ClimatologySector"
          }
        }
      },
      "required": [
        "month",
        "slot",
        "sampleCount",
        "calmCount",
        "sectors"
      ]
    },
    "ClimatologySector": {
      "type": "object",
      "properties": {
        "sector": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Sector index; bearing = sector × (360 / sectorCount)."
        },
        "count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Non-calm records whose direction fell in this sector."
        },
        "uSum": {
          "type": "number",
          "description": "Sum of zonal components, m/s — core's wind sign."
        },
        "vSum": {
          "type": "number",
          "description": "Sum of meridional components, m/s."
        },
        "speedSumMps": {
          "type": "number",
          "minimum": 0,
          "description": "Sum of scalar mean speeds, m/s."
        },
        "bandCounts": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "description": "Records per speed band against the document's thresholdsMps — length thresholdsMps.length + 1."
        },
        "maxGustMps": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "sector",
        "count",
        "uSum",
        "vSum",
        "speedSumMps",
        "bandCounts",
        "maxGustMps"
      ]
    }
  }
}
