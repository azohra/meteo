{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meteo.azohra.com/schema/stationcurrent.schema.json",
  "title": "StationCurrent",
  "description": "The single-station light document served at /current. Reuses the station shape with history null so clients need one decoder.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 2
    },
    "servedAt": {
      "type": "string",
      "format": "date-time"
    },
    "station": {
      "$ref": "#/$defs/Station"
    }
  },
  "required": [
    "schemaVersion",
    "servedAt",
    "station"
  ],
  "$defs": {
    "Station": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "sourceLabel": {
              "type": "string"
            },
            "pageUrl": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "latitude": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": -90,
                  "maximum": 90
                },
                {
                  "type": "null"
                }
              ]
            },
            "longitude": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": -180,
                  "exclusiveMaximum": 180
                },
                {
                  "type": "null"
                }
              ]
            },
            "timeZone": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "elevationM": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "declaredFavorableDirections": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/DirectionArc"
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "broadcastDelaySeconds": {
              "description": "The source's own live-playback delay, seconds; absent or null when the vendor states none.",
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "capabilities": {
              "$ref": "#/$defs/StationCapabilities"
            },
            "samplingWindowSeconds": {
              "anyOf": [
                {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "recommendedPollSeconds": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "status": {
              "type": "string",
              "const": "ok"
            },
            "reading": {
              "$ref": "#/$defs/Reading"
            },
            "history": {
              "anyOf": [
                {
                  "$ref": "#/$defs/History"
                },
                {
                  "type": "null"
                }
              ]
            },
            "telemetry": {
              "anyOf": [
                {
                  "$ref": "#/$defs/StationTelemetry"
                },
                {
                  "type": "null"
                }
              ]
            },
            "samples": {
              "anyOf": [
                {
                  "$ref": "#/$defs/LiveSamples"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "id",
            "name",
            "sourceLabel",
            "pageUrl",
            "latitude",
            "longitude",
            "timeZone",
            "elevationM",
            "capabilities",
            "samplingWindowSeconds",
            "recommendedPollSeconds",
            "status",
            "reading",
            "history"
          ]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "sourceLabel": {
              "type": "string"
            },
            "pageUrl": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "latitude": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": -90,
                  "maximum": 90
                },
                {
                  "type": "null"
                }
              ]
            },
            "longitude": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": -180,
                  "exclusiveMaximum": 180
                },
                {
                  "type": "null"
                }
              ]
            },
            "timeZone": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "elevationM": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "declaredFavorableDirections": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/DirectionArc"
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "broadcastDelaySeconds": {
              "description": "The source's own live-playback delay, seconds; absent or null when the vendor states none.",
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "capabilities": {
              "$ref": "#/$defs/StationCapabilities"
            },
            "samplingWindowSeconds": {
              "anyOf": [
                {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "recommendedPollSeconds": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "status": {
              "type": "string",
              "const": "unavailable"
            },
            "reason": {
              "type": "string",
              "enum": [
                "upstream_error",
                "timeout",
                "rate_limited",
                "contract_break",
                "not_configured"
              ]
            },
            "reading": {
              "type": "null"
            },
            "history": {
              "type": "null"
            }
          },
          "required": [
            "id",
            "name",
            "sourceLabel",
            "pageUrl",
            "latitude",
            "longitude",
            "timeZone",
            "elevationM",
            "capabilities",
            "samplingWindowSeconds",
            "recommendedPollSeconds",
            "status",
            "reason",
            "reading",
            "history"
          ]
        }
      ]
    },
    "DirectionArc": {
      "type": "object",
      "properties": {
        "fromDeg": {
          "type": "number",
          "description": "Degrees FROM, clockwise from north."
        },
        "toDeg": {
          "type": "number",
          "description": "Degrees FROM; fromDeg > toDeg wraps through north, boundaries inclusive."
        }
      },
      "required": [
        "fromDeg",
        "toDeg"
      ],
      "description": "One arc of favorable FROM bearings — core's DirectionArc shape on the wire."
    },
    "StationCapabilities": {
      "type": "object",
      "properties": {
        "gustLull": {
          "type": "boolean"
        },
        "temperature": {
          "type": "boolean"
        },
        "conditions": {
          "type": "boolean"
        },
        "history": {
          "type": "boolean"
        },
        "live": {
          "description": "The station has a live sample stream; absent or null reads as false.",
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "battery": {
          "description": "The station reports battery telemetry; absent or null reads as false.",
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "gustLull",
        "temperature",
        "conditions",
        "history"
      ],
      "description": "Declared from what the hardware carries, never inferred from data. Capabilities gate client UI structure; a dark sensor keeps its structure and reports null."
    },
    "Reading": {
      "type": "object",
      "properties": {
        "observedAt": {
          "type": "string",
          "format": "date-time"
        },
        "windAvgMps": {
          "type": "number",
          "minimum": 0,
          "description": "Wind speed in m/s, averaged over samplingWindowSeconds. Absence is null, never zero."
        },
        "windDirectionDeg": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "exclusiveMaximum": 360
            },
            {
              "type": "null"
            }
          ],
          "description": "Bearing the wind blows FROM, degrees [0, 360). null exactly when calm (windAvgMps below the WMO 0.5 m/s threshold) — calm carries no direction; a null on a blowing reading is a dead vane."
        },
        "windGustMps": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ],
          "description": "Peak m/s within the sampling window; null ≠ zero."
        },
        "windLullMps": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ],
          "description": "Minimum m/s within the sampling window; null ≠ zero."
        },
        "temperatureC": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "windChillC": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "conditions": {
          "anyOf": [
            {
              "$ref": "#/$defs/AirConditions"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "observedAt",
        "windAvgMps",
        "windDirectionDeg",
        "windGustMps",
        "windLullMps",
        "temperatureC",
        "windChillC",
        "conditions"
      ]
    },
    "AirConditions": {
      "type": "object",
      "properties": {
        "dewPointC": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "lastLightningStrikeAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "lastLightningStrikeDistanceKm": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "lightningStrikeCountLastHour": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "precipitationMinutesToday": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "precipitationRateMmPerHour": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "precipitationTodayMm": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "pressureTrend": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "falling",
                "rising",
                "steady",
                "unknown"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "relativeHumidityPercent": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "seaLevelPressureHpa": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "solarRadiationWm2": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "uvIndex": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "dewPointC",
        "lastLightningStrikeAt",
        "lastLightningStrikeDistanceKm",
        "lightningStrikeCountLastHour",
        "precipitationMinutesToday",
        "precipitationRateMmPerHour",
        "precipitationTodayMm",
        "pressureTrend",
        "relativeHumidityPercent",
        "seaLevelPressureHpa",
        "solarRadiationWm2",
        "uvIndex"
      ],
      "description": "Extended air data. null means 'not reported here' — it does not distinguish a missing sensor from a dark one; the station-level conditions capability gates whether a client allocates UI structure."
    },
    "History": {
      "type": "object",
      "properties": {
        "periodMinutes": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Minutes each point covers. Wind run, vane thinning, and dropout detection are functions of it."
        },
        "points": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/HistoryPoint"
          },
          "description": "A dropout is an ABSENT record, never a zeroed one — gaps carry no points."
        }
      },
      "required": [
        "periodMinutes",
        "points"
      ]
    },
    "HistoryPoint": {
      "type": "object",
      "properties": {
        "observedAt": {
          "type": "string",
          "format": "date-time"
        },
        "windAvgMps": {
          "type": "number",
          "minimum": 0,
          "description": "Mean m/s over the record's period."
        },
        "windGustMps": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "windLullMps": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "windDirectionDeg": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "exclusiveMaximum": 360
            },
            {
              "type": "null"
            }
          ],
          "description": "Degrees FROM; null exactly when the period was calm (below 0.5 m/s)."
        },
        "temperatureC": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "seaLevelPressureHpa": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "windVectorAvgMps": {
          "description": "Vector-mean m/s over the period — the honest input for further vector re-aggregation; at most windAvgMps. Absent or null reads as 'not published here'.",
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "temperatureMinC": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "temperatureMaxC": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "seaLevelPressureMinHpa": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "seaLevelPressureMaxHpa": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "observedAt",
        "windAvgMps",
        "windGustMps",
        "windLullMps",
        "windDirectionDeg",
        "temperatureC"
      ]
    },
    "StationTelemetry": {
      "type": "object",
      "properties": {
        "batteryVoltage": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Station supply volts. null means 'not reported here', never a dead battery."
        }
      },
      "required": [
        "batteryVoltage"
      ],
      "description": "Device telemetry. The station-level battery capability gates whether a client allocates UI structure; a dark sensor keeps its structure and reports null."
    },
    "LiveSamples": {
      "type": "object",
      "properties": {
        "intervalSeconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Seconds between samples."
        },
        "points": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LiveSample"
          },
          "description": "Oldest first. A dropout is an ABSENT sample, never a zeroed one."
        }
      },
      "required": [
        "intervalSeconds",
        "points"
      ]
    },
    "LiveSample": {
      "type": "object",
      "properties": {
        "observedAt": {
          "type": "string",
          "format": "date-time"
        },
        "windMps": {
          "type": "number",
          "minimum": 0,
          "description": "Instantaneous m/s — a single anemometer sample, not a period mean."
        },
        "windDirectionDeg": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "exclusiveMaximum": 360
            },
            {
              "type": "null"
            }
          ],
          "description": "Degrees FROM; null exactly when calm (below 0.5 m/s)."
        }
      },
      "required": [
        "observedAt",
        "windMps",
        "windDirectionDeg"
      ]
    }
  }
}
