{
  "name": "@azohra/meteo.briefing",
  "version": "0.6.1",
  "description": "Reads, analyzes, and draws published site forecasts: the document contract, pure derivations, comparison, month-archive history and transport, and three renderer-independent scene graphs (Meteogram, single-hour sounding, compare board) with an SVG serializer.",
  "keywords": [
    "weather",
    "meteorology",
    "forecast",
    "soaring",
    "paragliding",
    "free-flight",
    "meteogram",
    "svg"
  ],
  "author": "Justin Watts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/azohra/meteo.git",
    "directory": "briefing"
  },
  "type": "module",
  "files": [
    "dist",
    "!dist/internal",
    "schema"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./contract": {
      "types": "./dist/contract.d.ts",
      "default": "./dist/contract.js"
    },
    "./derive": {
      "types": "./dist/derive/index.d.ts",
      "default": "./dist/derive/index.js"
    },
    "./analyze": {
      "types": "./dist/analyze/index.d.ts",
      "default": "./dist/analyze/index.js"
    },
    "./compare": {
      "types": "./dist/compare.d.ts",
      "default": "./dist/compare.js"
    },
    "./transport": {
      "types": "./dist/transport.d.ts",
      "default": "./dist/transport.js"
    },
    "./history": {
      "types": "./dist/history/index.d.ts",
      "default": "./dist/history/index.js"
    },
    "./meteogram": {
      "types": "./dist/meteogram.d.ts",
      "default": "./dist/meteogram.js"
    },
    "./compare-board": {
      "types": "./dist/compare-board/index.d.ts",
      "default": "./dist/compare-board/index.js"
    },
    "./sounding": {
      "types": "./dist/sounding.d.ts",
      "default": "./dist/sounding.js"
    },
    "./schema/*.json": "./schema/*.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "pnpm --dir ../core build && vp pack",
    "test": "pnpm --dir ../core build && vp test",
    "typecheck": "pnpm --dir ../core build && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@azohra/meteo.core": "workspace:*",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "homepage": "https://meteo.azohra.com"
}
