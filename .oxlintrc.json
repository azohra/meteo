{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": { "correctness": "error" },
  "rules": {
    "unicorn/no-useless-spread": "off",
    "unicorn/no-useless-fallback-in-spread": "off"
  },
  "ignorePatterns": [
    "dist/**",
    "**/dist/**",
    "site/.astro/**",
    "node_modules/**",
    "**/*.json",
    "site/*.ts",
    "site/*.mjs",
    "site/*.cjs",
    "site/test/**",
    "site/public/**"
  ]
}
