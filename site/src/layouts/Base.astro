---
import SiteFooter from "../components/SiteFooter.astro";
import BrandLockup from "../components/BrandLockup.astro";
import GitHubMark from "../components/GitHubMark.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import { DOCS_LINK, GITHUB_URL, PRODUCT_LINKS, QUIET_LINKS, type NavKey } from "../lib/nav";
import { plateTokensStyle } from "../lib/plate-tokens";
import { SOCIAL_CARD } from "../lib/social-card.mjs";
import { THEME_PIN_SCRIPT } from "../lib/theme-pin";
/* IBM Plex is loaded only because it is the Meteogram artifact's
   reference type (gram/svg TOKEN_DEFAULTS); it is not part of the site's
   brand. */
import "@fontsource-variable/instrument-sans";
import "@fontsource/ibm-plex-sans/400.css";
import "@fontsource/ibm-plex-sans/600.css";
import "@fontsource/ibm-plex-sans/700.css";
import "@fontsource/ibm-plex-mono/400.css";
import "../styles/theme.css";

interface Props {
  title: string;
  description: string;
  activeNav?: NavKey;
  /** Pages that end in their own colophon (the homepage) carry the
      attribution inside it and skip the plain site footer. */
  hideFooter?: boolean;
}

const { title, description, activeNav, hideFooter = false } = Astro.props;

// Same link-preview card the docs pages emit via the Starlight head (see
// astro.config.mjs) — non-docs pages render through this layout. Facts come
// from src/lib/social-card.mjs; the origin from the config's `site`.
const socialCard = new URL(SOCIAL_CARD.path, Astro.site).href;

// Starlight emits canonical/og:url/sitemap for docs pages; non-docs pages
// render through this layout, so emit the same trio here.
const canonical = new URL(Astro.url.pathname, Astro.site).href;

// The generated --stab-*/--meteo-gram-* plate tokens, from the one shared
// generator (src/lib/plate-tokens.ts) the docs ThemeProvider also inlines.
const stabilityStyle = plateTokensStyle();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialCard} />
    <meta property="og:image:width" content={SOCIAL_CARD.width} />
    <meta property="og:image:height" content={SOCIAL_CARD.height} />
    <meta property="og:image:alt" content={SOCIAL_CARD.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={socialCard} />
    <style set:html={stabilityStyle}></style>
    {/* The theme pin, before first paint — the one shared script
        (src/lib/theme-pin.ts) the docs ThemeProvider also inlines. */}
    <script is:inline set:html={THEME_PIN_SCRIPT} />
  </head>
  <body>
    <header class="site-header">
      <div class="site-header-bar">
        <a class="site-brand" href="/" aria-label="meteo by Azohra home">
          <BrandLockup showDescriptor />
        </a>
        <nav class="site-nav" aria-label="Project">
          <span class="site-nav__products">
            {
              PRODUCT_LINKS.map(({ label, href, key }) => (
                <a href={href} aria-current={activeNav === key ? "page" : undefined}>
                  {label}
                </a>
              ))
            }
          </span>
          <a
            class="site-nav__docs"
            href={DOCS_LINK.href}
            aria-current={activeNav === DOCS_LINK.key ? "page" : undefined}
          >
            {DOCS_LINK.label}
          </a>
          <span class="site-nav__quiet">
            {
              QUIET_LINKS.map(({ label, href, key }) => (
                <a href={href} aria-current={activeNav === key ? "page" : undefined}>
                  {label}
                </a>
              ))
            }
          </span>
          <a class="site-nav__github" href={GITHUB_URL} aria-label="GitHub repository">
            <GitHubMark />
          </a>
          <ThemeToggle />
        </nav>
      </div>
    </header>

    <slot />

    {!hideFooter && <SiteFooter />}
  </body>
</html>
