---
import AttributionLine from "../components/AttributionLine.astro";
import BrandLockup from "../components/BrandLockup.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import { DOCS_LINK, GITHUB_URL, PRODUCT_LINKS, QUIET_LINKS, type NavKey } from "../lib/nav";
import { plateTokensStyle } from "../lib/plate-tokens";
import { SOCIAL_CARD } from "../lib/social-card.mjs";
import { THEME_PIN_SCRIPT } from "../lib/theme-pin";
/* Site chrome speaks one face; the Meteogram plates keep their own. IBM
   Plex is loaded ONLY because it is the Meteogram artifact's reference
   type (gram/svg TOKEN_DEFAULTS) — it is not part of the site's brand. */
import "@fontsource-variable/instrument-sans";
import "@fontsource/ibm-plex-sans/400.css";
import "@fontsource/ibm-plex-sans/600.css";
import "@fontsource/ibm-plex-sans/700.css";
import "@fontsource/ibm-plex-mono/400.css";
import "../styles/theme.css";

interface Props {
  title: string;
  description: string;
  activeNav?: NavKey;
  /** Pages that end in their own colophon (the homepage) carry the
      attribution inside it and skip the plain site footer. */
  hideFooter?: boolean;
}

const { title, description, activeNav, hideFooter = false } = Astro.props;

// Same link-preview card the docs pages emit via the Starlight head (see
// astro.config.mjs) — non-docs pages render through this layout. Facts come
// from src/lib/social-card.mjs; the origin from the config's `site`.
const socialCard = new URL(SOCIAL_CARD.path, Astro.site).href;

// Starlight emits canonical/og:url/sitemap for docs pages; non-docs pages
// render through this layout, so emit the same trio here.
const canonical = new URL(Astro.url.pathname, Astro.site).href;

// The generated --stab-*/--meteo-gram-* plate tokens, from the one shared
// generator (src/lib/plate-tokens.ts) the docs ThemeProvider also inlines.
const stabilityStyle = plateTokensStyle();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialCard} />
    <meta property="og:image:width" content={SOCIAL_CARD.width} />
    <meta property="og:image:height" content={SOCIAL_CARD.height} />
    <meta property="og:image:alt" content={SOCIAL_CARD.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={socialCard} />
    <style set:html={stabilityStyle}></style>
    {/* The theme pin, before first paint — the one shared script
        (src/lib/theme-pin.ts) the docs ThemeProvider also inlines. */}
    <script is:inline set:html={THEME_PIN_SCRIPT} />
  </head>
  <body>
    <header class="site-header">
      <div class="site-header-bar">
        <a class="site-brand" href="/" aria-label="meteo by Azohra home">
          <BrandLockup showDescriptor />
        </a>
        <nav class="site-nav" aria-label="Project">
          <span class="site-nav__products">
            {
              PRODUCT_LINKS.map(({ label, href, key }) => (
                <a href={href} aria-current={activeNav === key ? "page" : undefined}>
                  {label}
                </a>
              ))
            }
          </span>
          <a
            class="site-nav__docs"
            href={DOCS_LINK.href}
            aria-current={activeNav === DOCS_LINK.key ? "page" : undefined}
          >
            {DOCS_LINK.label}
          </a>
          <span class="site-nav__quiet">
            {
              QUIET_LINKS.map(({ label, href, key }) => (
                <a href={href} aria-current={activeNav === key ? "page" : undefined}>
                  {label}
                </a>
              ))
            }
          </span>
          <a class="site-nav__github" href={GITHUB_URL} aria-label="GitHub repository">
            <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
              <path
                fill="currentColor"
                d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
              />
            </svg>
          </a>
          <ThemeToggle />
        </nav>
      </div>
    </header>

    <slot />

    {
      !hideFooter && (
        <footer class="site-footer">
          <AttributionLine />
        </footer>
      )
    }
  </body>
</html>
