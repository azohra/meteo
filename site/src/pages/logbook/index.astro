---
import Base from "../../layouts/Base.astro";
import LogbookThumbnail from "../../components/logbook/LogbookThumbnail.astro";
import { logbookEntries } from "../../lib/logbook";

const entries = logbookEntries();
const dateFormat = new Intl.DateTimeFormat("en-CA", {
  year: "numeric",
  month: "short",
  day: "numeric",
  timeZone: "UTC",
});

function kindLabel(kind: (typeof entries)[number]["kind"]): string {
  if (kind === "case-study") return "Case study";
  if (kind === "experiment") return "Experiment";
  return "Method";
}
---

<Base
  title="Logbook — meteo by Azohra"
  description="Methods, experiments, and case studies behind the open meteorology platform."
  activeNav="logbook"
>
  <main class="shell logbook-shell">
    <header class="logbook-header">
      <p class="eyebrow">Logbook</p>
      <h1>Methods, evidence, and decisions</h1>
      <p>
        Dated accounts of substantive work across the platform: data validation, derivation
        evolution, lift definitions, ensemble interpretation, terrain diagnostics, smoke and
        radiation, palette design, catalogue growth, and operations.
      </p>
    </header>

    <section class="entries-section" aria-label="Logbook entries">
      <ol class="entry-list">
        {
          entries.map((entry) => (
            <li>
              <div class="entry-copy">
                <p class="entry-meta">
                  {kindLabel(entry.kind)}{" · "}<time datetime={entry.published.toISOString()}>{dateFormat.format(entry.published)}</time>{" · "}{entry.readingMinutes} min read{entry.status === "historical" && <> <span class="entry-status">Historical</span></>}
                </p>
                <h2><a href={entry.url}>{entry.title}</a></h2>
                <p>{entry.summary}</p>
              </div>
              <a class="entry-thumbnail" href={entry.url} aria-label={`Read ${entry.title}`}>
                <LogbookThumbnail entry={entry} />
              </a>
            </li>
          ))
        }
      </ol>
    </section>
  </main>
</Base>

<style>
  .logbook-shell {
    max-width: 1100px;
    padding-bottom: 42px;
  }
  .logbook-header {
    padding: 54px 0 32px;
    border-bottom: 1px solid var(--rule);
  }
  .eyebrow {
    margin: 0 0 10px;
    font: 650 15px/1.4 var(--sans);
    color: var(--accent);
  }
  .logbook-header h1 {
    max-width: 780px;
    margin: 0;
    font-size: clamp(32px, 4.4vw, 44px);
    line-height: 1.1;
  }
  .logbook-header > p:last-child {
    max-width: 780px;
    margin: 20px 0 0;
    font-size: 18px;
    line-height: 1.6;
    color: var(--ink-soft);
  }
  .entries-section {
    padding-bottom: 38px;
  }
  .entry-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .entry-list li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 250px;
    gap: 32px;
    padding: 24px 0 25px;
    border-bottom: 1px solid var(--rule);
  }
  .entry-meta {
    margin: 0;
    font: 500 14px/1.4 var(--sans);
    color: var(--ink-mute);
  }
  .entry-status {
    margin-inline-start: 8px;
    padding: 1px 7px;
    border: 1px solid var(--rule-strong);
    border-radius: 999px;
    font-size: 12.5px;
    font-weight: 600;
  }
  .entry-copy h2 {
    margin: 7px 0 9px;
    font-size: 28px;
    line-height: 1.12;
  }
  .entry-copy h2 a {
    color: var(--ink);
  }
  .entry-copy p {
    max-width: 790px;
    margin: 0;
    font-size: 17px;
    line-height: 1.55;
    color: var(--ink-soft);
  }
  .entry-thumbnail { display: block; align-self: center; color: inherit; text-decoration: none; }
  .entry-thumbnail:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
  @media (max-width: 900px) {
    .entry-list li { grid-template-columns: minmax(0, 1fr); gap: 16px; }
    .entry-thumbnail { width: min(100%, 420px); }
  }
  @media (max-width: 680px) {
    .logbook-header {
      padding-top: 38px;
    }
    .logbook-header h1 {
      font-size: 30px;
    }
    .entry-copy h2 {
      font-size: 22px;
    }
  }
</style>
