---
import Base from "../layouts/Base.astro";
import "@azohra/meteo.station/styles.css";
import "../components/station/station.css";
import StationHero from "../components/station/StationHero.astro";
import StationPrinciples from "../components/station/StationPrinciples.astro";
import CardsSection from "../components/station/sections/CardsSection.astro";
import ChartsSection from "../components/station/sections/ChartsSection.astro";
import RosesSection from "../components/station/sections/RosesSection.astro";

/* Every <meteo-*> tag on this page is the real custom-elements binding
   from @azohra/meteo.station/elements, upgraded by the client script at
   the bottom and fed a synthetic fleet generated in the visitor's browser
   (src/lib/station-exhibit.ts). Nothing is fetched; nothing is a
   screenshot. This page shows three sections (card, history charts,
   roses); the full catalogue is /docs/station/component-gallery/,
   rendered from the same components under
   src/components/station/sections/. */
---

<Base
  title="Station — live weather-station components — meteo by Azohra"
  description="Live wind from launch stations: vendor adapters read any weather station into one documented contract, and framework-free components render it live: dials, history charts, roses, and daily patterns."
  activeNav="station"
>
  <main id="main-content" class="station-main">
    <StationHero />

    <StationPrinciples />

    <div class="meteo-root station-gallery" id="station-exhibits">
      <meteo-station-feed
        id="station-feed"
        thresholds='{"unit":"kmh","values":[12,20,28]}'
      >
        <div class="station-gallery-inner section-inner">
          <CardsSection />
          <ChartsSection />
          <RosesSection />
        </div>
      </meteo-station-feed>
    </div>

    <section id="catalogue" class="station-closing" aria-labelledby="station-catalogue-title">
      <div class="section-inner">
        <h2 id="station-catalogue-title">Three exhibits here; the catalogue holds them all</h2>
        <p>
          Instruments, seasons, trends, the air matrix, the fleet table,
          one-line strips, the atoms, and an instrument with no provider at
          all: the <a href="/docs/station/component-gallery/">component
          gallery</a> renders every element in the binding, live, the same
          way this page does.
        </p>
      </div>
    </section>

    <section id="boundary" class="station-closing" aria-labelledby="station-boundary-title">
      <div class="section-inner">
        <h2 id="station-boundary-title">This package reads live stations. It doesn't forecast.</h2>
        <p>
          Station reads live weather stations and renders them; it is independent
          of the forecast and Meteogram capabilities. Forecasts are the job
          of <a href="/forecast/">@azohra/meteo.forecast</a>, the engine. Build the same
          page against your own stations: <a href="/docs/station/">the station
          documentation</a> covers the wire contract, adapters, the feed handler, and
          both bindings.
        </p>
      </div>
    </section>
  </main>
</Base>

<script>
  import { initStationGallery } from "../lib/station-gallery-client";
  initStationGallery();
</script>

<style>
  .station-main {
    padding-block-end: 72px;
  }

  .station-closing {
    padding-block: clamp(2.5rem, 5vw, 4rem) clamp(1rem, 2vw, 1.5rem);
  }

  .station-closing + .station-closing {
    padding-block-start: clamp(1rem, 2.5vw, 1.75rem);
  }

  .station-closing h2 {
    margin: 0;
    font-size: clamp(1.5rem, 3vw, 2rem);
    letter-spacing: -0.015em;
  }

  .station-closing p {
    max-width: 46rem;
    margin: 0.8rem 0 0;
    color: var(--ink-soft);
    line-height: 1.65;
  }
</style>
