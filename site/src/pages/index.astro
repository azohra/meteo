---
import HomeClosing from "../components/home/HomeClosing.astro";
import HomeDecoders from "../components/home/HomeDecoders.astro";
import HomeForecastData from "../components/home/HomeForecastData.astro";
import HomeHero from "../components/home/HomeHero.astro";
import HomeLiveStation from "../components/home/HomeLiveStation.astro";
import HomePath from "../components/home/HomePath.astro";
import HomeTeachingMeteogram from "../components/home/HomeTeachingMeteogram.astro";
import Base from "../layouts/Base.astro";
---

<Base
  title="meteo by Azohra — publish the weather for your launches"
  description="Open-source packages that turn weather-model output into soaring forecasts and show live wind from your launch, published on your own site for your pilots."
  hideFooter
>
  <main id="main-content" class="home-main">
    <HomeHero />
    <HomePath />
    <HomeTeachingMeteogram />
    <HomeLiveStation />
    <HomeForecastData />
    <HomeDecoders />
    <HomeClosing />
  </main>
</Base>

<style>
  .home-main {
    overflow: clip;
  }

  .home-main :global(section[id]) {
    scroll-margin-top: 5rem;
  }

  /* The briefing band is painted here rather than in HomeTeachingMeteogram:
     that component's markup and inner styles belong to the scenario
     exhibit, and this id-keyed rule outranks its scoped section rule. */
  .home-main :global(#briefing) {
    padding-block: clamp(5.5rem, 10vw, 9rem);
    background: var(--surface-sunken);
    border-block: 1px solid var(--rule-strong);
  }
</style>
