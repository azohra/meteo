---
import Base from "../layouts/Base.astro";
import EngineCli from "../components/forecast/EngineCli.astro";
import FlowFigures from "../components/forecast/FlowFigures.astro";
import ForecasterHero from "../components/forecast/ForecasterHero.astro";
import SampleDataset from "../components/forecast/SampleDataset.astro";

/* The engine's exhibit is its output. Every number, size, and JSON line on
   this page is read at build time from the committed sample dataset
   (site/public/data-sample — one real HRDPS continental run the engine
   captured), the two diagrams are the ones committed in
   forecast/docs/figures/, and the commands are the verified forms from
   forecast/README.md and the sample's own README. Nothing is fetched at
   runtime; nothing is a mock-up. */
---

<Base
  title="Forecast — the forecast engine and meteo CLI — meteo by Azohra"
  description="@azohra/meteo.forecast fetches each model's newest run for your launches, derives the soaring values, and publishes plain JSON wherever you host it, on your schedule, from one CLI."
  activeNav="forecast"
>
  <main id="main-content" class="forecaster-main">
    <ForecasterHero />
    <SampleDataset />
    <FlowFigures />
    <EngineCli />

    <section id="boundary" class="fc-boundary" aria-labelledby="boundary-title">
      <div class="section-inner">
        <h2 id="boundary-title">You run the engine yourself</h2>
        <p>
          The package is not a hosted service and ships no running pipeline. You supply the
          cron schedule that triggers builds, the site catalogue it builds from, and the storage
          bucket and credentials the documents land in.
          <a href="https://acrophobia.ca">acrophobia.ca</a> runs the reference pipeline. To set
          up your own, <a href="/docs/forecast/run-one-model/">Run one model</a> walks through the
          first build. The <a href="/docs/forecast/">forecast documentation</a> is the engine's
          full reference.
        </p>
      </div>
    </section>
  </main>
</Base>

<style>
  .forecaster-main {
    padding-block-end: 72px;
  }

  .fc-boundary {
    padding-block: clamp(2.5rem, 5vw, 4rem) clamp(1rem, 2vw, 1.5rem);
  }

  .fc-boundary h2 {
    margin: 0;
    font-size: clamp(1.5rem, 3vw, 2rem);
    letter-spacing: -0.015em;
  }

  .fc-boundary p {
    max-width: 46rem;
    margin: 0.8rem 0 0;
    color: var(--ink-soft);
    line-height: 1.65;
  }
</style>
