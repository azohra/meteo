---
import ExhibitLinks from "./ExhibitLinks.astro";
import SectionHeader from "./SectionHeader.astro";
import "@azohra/meteo.station/styles.css";

/* The station exhibit: a real <meteo-station-card> from the package's
   custom-elements binding, fed a synthetic season generated in the visitor's
   browser (src/lib/station-exhibit.ts). Living components, not a
   screenshot — the full gallery lives at /docs/station/component-gallery/. */
---

<section id="station" class="home-station-section" aria-labelledby="home-station-title">
  <div class="home-section-inner section-inner">
    <SectionHeader
      number="03"
      eyebrow="@azohra/meteo.station"
      title="Live wind from the launch's weather station"
      titleId="home-station-title"
      intro="Adapters read each vendor's hardware into one documented contract, and the components render the readings on your own page, no iframe."
    />

    <div class="home-station-layout">
      <div class="meteo-root home-station-card" id="home-station-root">
        <meteo-station-feed
          id="home-station-feed"
          thresholds='{"unit":"kmh","values":[12,20,28]}'
        >
          <meteo-station-card station-id="launch-ridge"></meteo-station-card>
        </meteo-station-feed>
      </div>

      <div class="home-station-copy">
        <dl class="home-station-facts">
          <div>
            <dt>mount</dt>
            <dd><code>&lt;meteo-station-card station-id="launch-ridge"&gt;</code>: the element your page mounts</dd>
          </div>
          <div>
            <dt>bindings</dt>
            <dd>Custom elements, framework-free; the React binding renders the identical DOM</dd>
          </div>
          <div>
            <dt>thresholds</dt>
            <dd><code>{'{"unit":"kmh","values":[12,20,28]}'}</code>: this card's wind bands, declared on the feed</dd>
          </div>
        </dl>
        <ExhibitLinks
          label="Continue with Station"
          links={[
            { text: "See the full component gallery", href: "/docs/station/component-gallery/" },
            { text: "Wire up your own stations", href: "/docs/station/getting-started/" },
          ]}
        />
      </div>
    </div>
  </div>
</section>

<script>
  /* Data first, definition second: the shared wiring (src/lib/station-live)
     feeds every station exhibit on the page — this card and the hero
     instrument — before defining the tags, so nothing upgrades empty. */
  import { wireStationExhibits } from "../../lib/station-live";

  wireStationExhibits();
</script>

<style>
  /* 03 returns to the bare page ground between the briefing and data bands;
     open padding — the live instrument gets air. */
  .home-station-section {
    padding-block: clamp(4.5rem, 9vw, 8rem);
  }

  .home-station-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(16rem, 0.85fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }

  .home-station-card {
    max-width: 33rem;
  }

  .home-station-facts {
    display: grid;
    max-width: 34rem;
    margin: 0 0 1.4rem;
    padding: 0;
    border: 1px solid var(--rule);
    border-radius: var(--radius-small);
    overflow: hidden;
  }

  .home-station-facts > div {
    display: grid;
    gap: 0.25rem;
    padding: 0.75rem 0.95rem;
    background: var(--surface);
  }

  .home-station-facts > div + div {
    border-block-start: 1px solid var(--rule);
  }

  .home-station-facts dt {
    color: var(--accent);
    font: 600 0.64rem/1.4 var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .home-station-facts dd {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.88rem;
    line-height: 1.5;
  }

  .home-station-copy code {
    font-family: var(--mono);
    font-size: 0.9em;
    color: var(--ink);
    background: var(--surface-sunken);
    padding: 1px 5px;
    border-radius: 4px;
  }

  @media (max-width: 58rem) {
    .home-station-layout {
      grid-template-columns: 1fr;
    }
  }

</style>
