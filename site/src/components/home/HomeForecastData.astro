---
import SectionHeader from "./SectionHeader.astro";

// The engine and its artifact are one story: `meteo forecast build` writes the
// JSON, and the same terminal reads it back. Commands and paths restate
// README.md § "Published data" and /docs/forecast/configure-launches/.
const references = [
  {
    title: "Configure your launches",
    detail: "sites.json declares each launch; the engine fetches, derives, and publishes on your schedule.",
    href: "/docs/forecast/configure-launches/",
  },
  {
    title: "Model catalogue",
    detail: "models.json declares each model's grid, cadence, capabilities, and lifecycle, absences included.",
    href: "/docs/briefing/catalogue/",
  },
  {
    title: "Contract, schemas, and units",
    detail: "Every document has a published JSON Schema, so non-JS consumers are first-class. SI units, declared semantics.",
    href: "/docs/briefing/contract/",
  },
  {
    title: "Forecast history",
    detail: "Append-only monthly archives beside every current run: compare a forecast with what was published before.",
    href: "/docs/briefing/history-archives/",
  },
];
---

<section id="data" class="home-data" aria-labelledby="home-data-title">
  <div class="home-data__inner section-inner">
    <SectionHeader
      number="04"
      eyebrow="@azohra/meteo.forecast"
      title="Publish forecasts anyone can read"
      titleId="home-data-title"
      intro="meteo forecast build fetches each model's newest run, derives the soaring numbers, and writes static JSON at stable paths, a schemaVersion on every document. curl is a complete client. You own the pipeline it runs in — a schedule, a bucket, your credentials; the platform ships the engine, not a hosted service."
    />

    <div class="home-data__layout">
      <div
        class="home-data__terminal"
        aria-label="A complete session: publish forecasts, then read the published JSON"
      >
        <p class="home-data__terminal-title">publish, then read it back · meteo.azohra.com/data-sample</p>
        <pre><code><span class="t-comment"># your sites.json in, derived forecasts out, on your schedule</span>
<span class="t-prompt">$</span> meteo forecast build</code></pre>
        <pre><code><span class="t-comment"># one site, one model, every forecast hour + derived quantities</span>
<span class="t-prompt">$</span> curl -sS \
    https://meteo.azohra.com/data-sample/hrdps-continental/sites/test-hill.json \
    | jq '.hours[] | {"{"}validAt{"}"} + .derived'</code></pre>
        <pre><code><span class="t-comment"># the stable paths, under any operator's root</span>
&lt;root&gt;/models.json
&lt;root&gt;/&lt;model&gt;/manifest.json
&lt;root&gt;/&lt;model&gt;/sites/&lt;slug&gt;.json</code></pre>
      </div>

      <ul class="home-data__refs">
        {references.map((reference) => (
          <li>
            <a href={reference.href}>
              <strong>{reference.title}</strong>
              <span>{reference.detail}</span>
              <small>Read the reference <span aria-hidden="true">→</span></small>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  /* 04 is the second full-bleed band of the scroll's alternation — the
     glacier-tinted one. The briefing band dips neutral; this one turns
     toward the accent, so the two bands read as different registers and
     the theme-invariant terminal bezel pops on it in either arm. */
  .home-data {
    padding-block: clamp(5rem, 9vw, 8.5rem);
    background: var(--surface-accent);
    border-block: 1px solid var(--rule-strong);
  }

  .home-data__layout {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(17rem, 0.85fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
  }

  /* The terminal panel keeps one fixed dark instrument face in either
     theme — the dial's own bezel. */
  .home-data__terminal {
    /* Grid items default to min-width auto; the no-wrap command lines would
       otherwise floor the track wider than a phone. The pre scrolls instead. */
    min-width: 0;
    padding: 0 0 1.2rem;
    color: var(--term-ink);
    background: var(--term-bg);
    border: 1px solid var(--term-border);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .home-data__terminal-title {
    margin: 0 0 0.9rem;
    padding: 0.6rem 1.2rem;
    border-block-end: 1px solid var(--term-border);
    color: var(--term-muted);
    font: 600 0.68rem/1.4 var(--mono);
    letter-spacing: 0.05em;
  }

  .home-data__terminal pre {
    margin: 0;
    padding-inline: 1.2rem;
    overflow-x: auto;
    font: 0.8rem/1.7 var(--mono);
  }

  .home-data__terminal pre + pre {
    margin-block-start: 1.1rem;
    padding-block-start: 1rem;
    border-block-start: 1px dashed var(--term-border);
  }

  .t-comment {
    color: var(--term-muted);
    font-style: italic;
  }

  .t-prompt {
    color: var(--term-string);
  }

  .home-data__refs {
    display: grid;
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
    list-style: none;
  }

  .home-data__refs li + li {
    border-block-start: 1px solid var(--rule);
  }

  .home-data__refs a {
    display: grid;
    gap: 0.35rem;
    padding: 1.05rem 1.15rem;
    color: var(--ink);
    background: var(--surface);
  }

  /* The band itself is --surface-accent now; hover tints halfway toward it
     so the state stays legible against the ground. */
  .home-data__refs a:hover {
    background: color-mix(in srgb, var(--surface-accent) 55%, var(--surface));
    text-decoration: none;
  }

  .home-data__refs strong {
    font: 700 1.02rem/1.25 var(--sans);
  }

  .home-data__refs span {
    color: var(--ink-soft);
    font-size: 0.86rem;
    line-height: 1.5;
  }

  .home-data__refs small {
    color: var(--accent);
    font: 600 0.66rem/1.4 var(--mono);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  @media (max-width: 58rem) {
    .home-data__layout {
      grid-template-columns: 1fr;
    }
  }
</style>
