---
import SectionHeader from "./SectionHeader.astro";

// Facts restated from README.md § "The decoders" and the /docs/grib/ and
// /docs/j2k/ pages. Browser-safety details are documented at
// /docs/grib/coverage/ § "What the core never does"; the claim below
// links there instead of restating them.
const decoders = [
  {
    name: "@azohra/meteo.grib",
    title: "GRIB2 in pure TypeScript",
    detail:
      "Decodes rotated lat-lon and Lambert grids, complex packing, and multi-field messages, with helpers for NOMADS .idx byte ranges. It exists because no maintained JavaScript decoder covered the grids ECCC and NOAA ship. Decoded values match ecCodes bit for bit.",
    install: "pnpm add @azohra/meteo.grib",
    href: "/docs/grib/",
  },
  {
    name: "@azohra/meteo.j2k",
    title: "JPEG 2000 for ECCC's GRIB2",
    detail:
      "Decodes the JPEG 2000 codestreams inside ECCC's GRIB2 files. It covers exactly the subset those feeds use, and anything outside it fails with a named error. Each step cites its clause of the standard. @azohra/meteo.grib uses it in production.",
    install: "pnpm add @azohra/meteo.j2k",
    href: "/docs/j2k/",
  },
];
---

<section id="decoders" class="home-decoders" aria-labelledby="home-decoders-title">
  <div class="home-decoders__inner section-inner">
    <SectionHeader
      number="05"
      eyebrow="@azohra/meteo.grib · @azohra/meteo.j2k"
      title="Read the provider bytes yourself"
      titleId="home-decoders-title"
      intro="The engine reads provider files with two pure-TypeScript decoders. Each is published as its own package, and both match the reference codecs exactly."
    />

    <ul class="home-decoders__cards">
      {decoders.map((decoder) => (
        <li>
          <a href={decoder.href}>
            <code>{decoder.install}</code>
            <strong>{decoder.title}</strong>
            <span>{decoder.detail}</span>
            <small>Read the {decoder.name} docs <span aria-hidden="true">→</span></small>
          </a>
        </li>
      ))}
    </ul>

    <p class="home-decoders__browser">
      Both decoders also run in the browser. See
      <a href="/docs/grib/coverage/#what-the-core-never-does">what the core never does</a>.
    </p>
  </div>
</section>

<style>
  /* 05 is the dense two-card coda on the bare page ground — compressed
     cadence before the closing band opens. */
  .home-decoders {
    padding-block: clamp(3.5rem, 6vw, 5.5rem);
  }

  .home-decoders__cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
    list-style: none;
  }

  .home-decoders__cards li + li {
    border-inline-start: 1px solid var(--rule);
  }

  .home-decoders__cards a {
    display: grid;
    gap: 0.55rem;
    align-content: start;
    height: 100%;
    padding: 1.35rem 1.4rem;
    color: var(--ink);
    background: var(--surface);
  }

  .home-decoders__cards a:hover {
    background: var(--surface-accent);
    text-decoration: none;
  }

  .home-decoders__cards code {
    color: var(--accent);
    font: 600 0.72rem/1.5 var(--mono);
  }

  .home-decoders__cards strong {
    font: 700 1.15rem/1.25 var(--sans);
  }

  .home-decoders__cards span {
    color: var(--ink-soft);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .home-decoders__cards small {
    margin-block-start: 0.3rem;
    color: var(--accent);
    font: 600 0.66rem/1.4 var(--mono);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .home-decoders__browser {
    margin: 1rem 0 0;
    color: var(--ink-soft);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .home-decoders__browser a {
    color: var(--accent);
    font-weight: 600;
  }

  @media (max-width: 44rem) {
    .home-decoders__cards {
      grid-template-columns: 1fr;
    }

    .home-decoders__cards li + li {
      border-inline-start: 0;
      border-block-start: 1px solid var(--rule);
    }
  }
</style>
