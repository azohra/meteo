---
import type { OverlayName } from "@azohra/meteo.briefing/meteogram";
import ControlGroup from "../figure/ControlGroup.astro";
import Figure from "../figure/Figure.astro";
import SyntheticMeteogram from "../meteogram/SyntheticMeteogram.astro";
import MeteogramAnnotations from "../meteogram/MeteogramAnnotations.astro";
import MeteogramKey from "../meteogram/MeteogramKey.astro";
import {
  onlyOverlays,
  overlayAvailability,
  renderSyntheticMeteogram,
} from "../../lib/example-meteogram";
import { scenarioById } from "../../lib/scenarios";
import ExhibitLinks from "./ExhibitLinks.astro";
import SectionHeader from "./SectionHeader.astro";

const scenario = scenarioById("convective-cycle");
const overlays = onlyOverlays(
  "pressure",
  "precipitation",
  "cape",
  "cloudLayers",
  "thermalStrength",
  "surfaceTemperature",
  "temperature",
  "stability",
  "wind",
  "gusts",
  "clouds",
  "boundaryLayerTop",
  "pblHeight",
  "usableLiftTop",
  "cloudBase",
  "launch",
  "selectedHour",
);
const availability = overlayAvailability(scenario);
const { scene } = renderSyntheticMeteogram(scenario, { overlays });
const layers: Array<{
  overlay: OverlayName;
  label: string;
  detail: string;
  checked: boolean;
}> = [
  {
    overlay: "stability",
    label: "Thermal structure",
    detail: "Stability through each model column",
    checked: true,
  },
  {
    overlay: "wind",
    label: "Wind aloft",
    detail: "Speed and direction at each height",
    checked: true,
  },
  {
    overlay: "clouds",
    label: "Moisture",
    detail: "Near-saturated layers through each profile",
    checked: true,
  },
  {
    overlay: "boundaryLayerTop",
    label: "Parcel boundary",
    detail: "Depth of the convective mixing layer",
    checked: true,
  },
  {
    overlay: "usableLiftTop",
    label: "Usable lift",
    detail: "Height where lift falls below 1.0 m/s",
    checked: true,
  },
  {
    overlay: "cloudBase",
    label: "Cloud base",
    detail: "The lowest condensation height",
    checked: true,
  },
];

for (const layer of layers) {
  if (!availability[layer.overlay]) {
    throw new Error(`convective-cycle must provide the homepage ${layer.overlay} layer`);
  }
}
for (const overlay of ["temperature", "cape", "gusts", "pblHeight", "cloudLayers", "surfaceTemperature"] as const) {
  if (!availability[overlay]) {
    throw new Error(`convective-cycle must provide the homepage ${overlay} context`);
  }
}
---

<section id="briefing" class="home-meteogram-section" aria-labelledby="home-meteogram-title">
  <div class="home-section-inner section-inner">
    <SectionHeader
      eyebrow="@azohra/meteo.briefing"
      title="Tells you what kind of day it is"
      titleId="home-meteogram-title"
      intro="The package reads published forecasts and answers in typed findings; the Meteogram is its chart. Toggle a layer to see how the chart builds."
    />

    <dl class="home-briefing-tiers">
      <div>
        <dt>analyze</dt>
        <dd>Thermal window, cap timing, wind exceedance</dd>
      </div>
      <div>
        <dt>compare</dt>
        <dd>Where models agree and diverge over one launch</dd>
      </div>
      <div>
        <dt>history</dt>
        <dd>How a model's successive runs converge</dd>
      </div>
      <div>
        <dt>meteogram</dt>
        <dd>Wind, stability, moisture, and the heights that limit a climb, hour by hour</dd>
      </div>
    </dl>

    <Figure
      id="home-convective-cycle"
      title="A fair-weather convective day"
      description={scenario.accessibilityDescription}
      caption="The parcel boundary, cloud base, and usable-lift top follow different paths because each measures a different limit."
      units="Altitude m MSL and ft MSL; wind barbs in km/h; surface strips as labelled"
      {scenario}
      headingLevel="h3"
      size="content"
      class="home-meteogram-figure"
    >
      <Fragment slot="controls">
        <ControlGroup label="Show or hide the principal Meteogram layers" resetLabel="Reset layers">
          <div class="home-layer-controls">
            {layers.map((layer) => (
              <label class="home-layer-control">
                <input
                  type="checkbox"
                  data-meteogram-overlay={layer.overlay}
                  checked={layer.checked}
                  autocomplete="off"
                />
                <span class="home-layer-control__copy">
                  <strong>{layer.label}</strong>
                  <small>{layer.detail}</small>
                </span>
              </label>
            ))}
          </div>
        </ControlGroup>
      </Fragment>

      <MeteogramAnnotations {scenario} {scene} mode="summary" />
      <SyntheticMeteogram
        {scenario}
        idPrefix="home-convective-cycle"
        interactive
        class="home-meteogram-preview"
        {overlays}
        widthPx={896}
        plotHeightPx={320}
        scrollLabel="Scrollable Meteogram with layer toggles"
      />

      <Fragment slot="legend">
        <MeteogramKey
          {scene}
          chartIdPrefix="home-convective-cycle"
          scrollLabel="Scrollable key for the homepage Meteogram"
        />
      </Fragment>
    </Figure>

    <div class="home-meteogram-links">
      <ExhibitLinks
        label="Continue with the Meteogram"
        links={[
          { text: "Learn to read every mark", href: "/docs/briefing/reading-a-meteogram/" },
          { text: "Render your first Meteogram", href: "/docs/briefing/render-first-meteogram/" },
          { text: "Turn a profile into findings", href: "/docs/briefing/analyze/" },
        ]}
      />
    </div>
  </div>
</section>

<style>
  .home-meteogram-section {
    padding-block: clamp(4.5rem, 9vw, 8rem);
    background: color-mix(in srgb, var(--surface) 48%, transparent);
    border-block: 1px solid var(--rule);
  }

  .home-briefing-tiers {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: 0 0 clamp(1.6rem, 4vw, 2.8rem);
    padding: 0;
    border: 1px solid var(--rule);
    border-radius: var(--radius-small);
    overflow: hidden;
  }

  .home-briefing-tiers > div {
    display: grid;
    gap: 0.3rem;
    align-content: start;
    padding: 0.85rem 1rem;
    background: color-mix(in srgb, var(--surface) 70%, transparent);
  }

  .home-briefing-tiers > div + div {
    border-inline-start: 1px solid var(--rule);
  }

  .home-briefing-tiers dt {
    color: var(--accent);
    font: 600 0.66rem/1.4 var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .home-briefing-tiers dd {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.85rem;
    line-height: 1.45;
  }

  @media (max-width: 48rem) {
    .home-briefing-tiers {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .home-briefing-tiers > div:nth-child(odd) {
      border-inline-start: 0;
    }

    .home-briefing-tiers > div:nth-child(n + 3) {
      border-block-start: 1px solid var(--rule);
    }
  }

  .home-layer-controls {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    flex: 1 1 100%;
    gap: 0.5rem;
    width: 100%;
  }

  .home-meteogram-section :global(.home-meteogram-figure) {
    width: min(100%, 56rem);
    margin-inline: auto;
  }

  .home-meteogram-links {
    display: flex;
    justify-content: center;
    margin-block-start: clamp(1.6rem, 3vw, 2.4rem);
  }

  .home-meteogram-section :global(.home-meteogram-preview .synthetic-meteogram__mount) {
    display: grid;
    justify-items: center;
  }

  :global(.meteo-gram-control-group .home-layer-control) {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.55rem;
    align-items: start;
    min-height: 4.2rem;
    padding: 0.65rem;
    background: color-mix(in srgb, var(--surface) 70%, transparent);
    border: 1px solid var(--rule);
    cursor: pointer;
  }

  :global(.meteo-gram-control-group .home-layer-control:hover) {
    background: var(--surface);
    border-color: var(--accent);
  }

  :global(.meteo-gram-control-group .home-layer-control input) {
    width: 1.05rem;
    min-width: 1.05rem;
    height: 1.05rem;
    min-height: 1.05rem;
    margin: 0.1rem 0 0;
    accent-color: var(--accent);
  }

  .home-layer-control__copy {
    display: grid;
    gap: 0.15rem;
  }

  .home-layer-control__copy strong {
    color: var(--ink);
    font: 700 0.78rem/1.3 var(--sans);
  }

  .home-layer-control__copy small {
    color: var(--ink-mute);
    font: 0.65rem/1.35 var(--mono);
  }

  @media (max-width: 48rem) {
    .home-layer-controls {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 32rem) {
    .home-layer-controls {
      grid-template-columns: 1fr;
    }
  }
</style>
