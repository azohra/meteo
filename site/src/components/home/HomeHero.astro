---
import DayArc from "./DayArc.astro";
import "@azohra/meteo.station/styles.css";

/* The hero states the product in one line, offers two ways in, and shows
   two real things: the live custom-elements station binding (fed the same
   synthetic season as /station/) and the day arc, drawn from a committed
   scenario's published heights. Nothing here is a screenshot. */
---

<section class="home-hero" aria-labelledby="home-title">
  <div class="home-hero__copy">
    <h1 id="home-title">Publish the weather for your launches.</h1>
    <p class="home-hero__lede">
      Open-source packages that turn weather-model output into soaring forecasts and
      show live wind from your launch. You run them, and your pilots read the results on your site.
    </p>
    <nav class="home-hero__actions" aria-label="Start with meteo by Azohra">
      <a class="home-hero__action home-hero__action--primary" href="/docs/">Start building</a>
      <a class="home-hero__action" href="https://github.com/azohra/meteo">View on GitHub</a>
    </nav>
  </div>

  <figure class="home-hero__station">
    <div class="meteo-root">
      <meteo-station-feed id="hero-station-feed" thresholds='{"unit":"kmh","values":[12,20,28]}'>
        <meteo-current-conditions station-id="launch-ridge"></meteo-current-conditions>
      </meteo-station-feed>
    </div>
    <figcaption>The station component, playing a synthetic test season.</figcaption>
  </figure>

  <div class="home-hero__arc">
    <DayArc />
  </div>
</section>

<script>
  /* The shared wiring feeds every station exhibit on the page before
     defining the tags, so this coexists with the station section below. */
  import { wireStationExhibits } from "../../lib/station-live";

  wireStationExhibits();
</script>

<style>
  .home-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 22rem);
    grid-template-areas:
      "copy station"
      "arc arc";
    gap: clamp(2.5rem, 5vw, 4rem) clamp(2.5rem, 6vw, 6rem);
    align-items: center;
    width: min(74.25rem, calc(100% - 3.5rem));
    margin-inline: auto;
    padding-block: clamp(4rem, 7vw, 6rem) clamp(3.5rem, 6vw, 5rem);
  }

  .home-hero__copy {
    grid-area: copy;
  }

  h1 {
    max-width: 16ch;
    margin: 0 0 1.4rem;
    font-size: clamp(2.6rem, 5.4vw, 4.2rem);
    line-height: 1.04;
    letter-spacing: -0.03em;
  }

  .home-hero__lede {
    max-width: 38rem;
    margin: 0;
    color: var(--ink-soft);
    font-size: clamp(1.08rem, 1.9vw, 1.28rem);
    line-height: 1.58;
  }

  .home-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-block-start: 2rem;
  }

  .home-hero__action {
    display: inline-flex;
    align-items: center;
    min-height: 2.9rem;
    padding: 0.7rem 1.3rem;
    color: var(--ink);
    background: transparent;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-small);
    font: 600 0.95rem/1.2 var(--sans);
    transition:
      color 150ms ease,
      border-color 150ms ease,
      background-color 150ms ease;
  }

  .home-hero__action:hover {
    color: var(--accent);
    border-color: var(--accent);
    text-decoration: none;
  }

  .home-hero__action--primary {
    color: var(--accent-ink);
    background: var(--accent);
    border-color: var(--accent);
  }

  .home-hero__action--primary:hover {
    color: var(--accent-ink);
    background: var(--accent-strong);
    border-color: var(--accent-strong);
  }

  .home-hero__station {
    grid-area: station;
    margin: 0;
  }

  .home-hero__station figcaption {
    margin-block-start: 0.7rem;
    color: var(--ink-mute);
    font-size: 0.86rem;
    line-height: 1.45;
    text-align: center;
  }

  .home-hero__arc {
    grid-area: arc;
    min-width: 0;
  }

  @media (max-width: 52rem) {
    .home-hero {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        "copy"
        "arc"
        "station";
    }

    .home-hero__station {
      width: min(100%, 22rem);
      justify-self: center;
    }
  }

  @media (max-width: 43rem) {
    .home-hero {
      width: min(100% - 2rem, 74.25rem);
      padding-block-start: 3rem;
    }

    .home-hero__actions {
      display: grid;
    }

    .home-hero__action {
      justify-content: center;
    }
  }
</style>
