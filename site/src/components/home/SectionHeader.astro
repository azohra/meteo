---
interface Props {
  /** Optional package name above the title, set as code: the one kicker
      that tells a reader something the title doesn't. */
  eyebrow?: string;
  title: string;
  intro: string;
  titleId: string;
  align?: "left" | "split";
}

const { eyebrow, title, intro, titleId, align = "split" } = Astro.props;
---

<header class:list={["home-section-head", `home-section-head--${align}`]}>
  <div>
    {eyebrow && <p class="home-section-head__eyebrow">{eyebrow}</p>}
    <h2 id={titleId}>{title}</h2>
  </div>
  <p class="home-section-head__intro">{intro}</p>
</header>

<style>
  .home-section-head {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(18rem, 1.1fr);
    gap: clamp(1.5rem, 5vw, 5rem);
    align-items: end;
    margin-block-end: clamp(1.8rem, 4vw, 3rem);
  }

  .home-section-head--left {
    grid-template-columns: minmax(0, 1fr);
    gap: 0.8rem;
    align-items: start;
  }

  .home-section-head__eyebrow {
    margin: 0 0 0.6rem;
    color: var(--accent-strong);
    font: 500 0.88rem/1.4 var(--mono);
  }

  h2 {
    max-width: 30ch;
    margin: 0;
    font-size: clamp(1.7rem, 3.4vw, 2.5rem);
    line-height: 1.12;
  }

  .home-section-head__intro {
    max-width: 42rem;
    margin: 0;
    color: var(--ink-soft);
    font-size: clamp(1rem, 1.6vw, 1.13rem);
    line-height: 1.62;
  }

  @media (max-width: 44rem) {
    .home-section-head {
      grid-template-columns: 1fr;
      gap: 1rem;
      align-items: start;
    }
  }
</style>
