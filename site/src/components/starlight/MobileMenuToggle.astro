---
import { Icon } from "@astrojs/starlight/components";
---

<button
  popovertarget="starlight__sidebar"
  aria-label="Menu"
  class="sl-flex md:sl-hidden print:hidden"
>
  <Icon name="bars" class="open-menu" />
  <Icon name="close" class="close-menu" />
</button>

<style>
  @layer starlight.components {
    button {
      position: fixed;
      z-index: var(--sl-z-index-navbar);
      top: calc((var(--sl-nav-height) - var(--sl-menu-button-size)) / 2);
      inset-inline-end: var(--sl-nav-pad-x);
      width: var(--sl-menu-button-size);
      height: var(--sl-menu-button-size);
      padding: 0.5rem;
      border: 1px solid transparent;
      border-radius: 50%;
      background: var(--surface-raised);
      color: var(--ink);
      cursor: pointer;
    }

    button:hover {
      border-color: var(--rule);
      background: var(--surface-sunken);
    }

    button:has(~ :popover-open) {
      border-color: var(--accent);
      background: var(--ink);
      color: var(--accent-ink);
    }

    button:has(~ :popover-open) :global(.open-menu) {
      display: none;
    }

    button:not(:has(~ :popover-open)) :global(.close-menu) {
      display: none;
    }
  }
</style>

<style is:global>
  body:has(#starlight__sidebar:popover-open) {
    overflow: hidden;
  }

  @media (min-width: 50rem) {
    body:has(#starlight__sidebar:popover-open) {
      overflow: auto;
    }
  }
</style>
