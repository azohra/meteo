---
import Search from "@astrojs/starlight/components/Search.astro";
import { GITHUB_URL, NAV_LINKS } from "../../lib/nav";
import GitHubMark from "../GitHubMark.astro";
import ThemeToggle from "../ThemeToggle.astro";
import SiteTitle from "./SiteTitle.astro";
---

<div class="docs-header">
  <div class="title-wrapper"><SiteTitle /></div>
  <div class="search"><Search /></div>
  <nav class="global-nav" aria-label="Project">
    {
      NAV_LINKS.map(({ label, href }) => (
        <a href={href} aria-current={Astro.url.pathname.startsWith(href) ? "page" : undefined}>
          {label}
        </a>
      ))
    }
    <a class="global-nav__github" href={GITHUB_URL} aria-label="GitHub repository">
      <GitHubMark size={15} />
    </a>
    <ThemeToggle />
  </nav>
</div>

<style>
  @layer starlight.components {
    .docs-header {
      display: grid;
      grid-template-columns: auto minmax(12rem, 22rem) 1fr;
      align-items: center;
      gap: clamp(0.75rem, 2vw, 1.5rem);
      height: 100%;
    }

    .title-wrapper {
      min-width: 0;
      overflow: clip;
      padding: 0.25rem;
      margin: -0.25rem;
    }

    .search {
      min-width: 0;
      width: 100%;
      justify-self: start;
    }

    .global-nav {
      justify-self: end;
      /* Align the nav cluster's right edge with the homepage header bar
         (max-width 1188px, centered, 24px padding) so the links do not
         jump when moving between the homepage and the docs. */
      margin-inline-end: max(0px, calc((100vw - 1188px) / 2 + 24px - var(--sl-nav-pad-x)));
      display: flex;
      align-items: center;
      gap: 1.05rem;
      font-size: 0.82rem;
      font-weight: 600;
      white-space: nowrap;
    }

    .global-nav a {
      color: var(--ink-mute);
      text-decoration: none;
      text-underline-offset: 0.25em;
    }

    .global-nav a:hover {
      color: var(--accent);
      text-decoration: none;
    }

    .global-nav a[aria-current="page"] {
      color: var(--ink);
    }

    .global-nav__github {
      display: inline-flex;
      align-items: center;
    }

    @media (max-width: 71.99rem) {
      .docs-header {
        grid-template-columns: minmax(0, 1fr) auto;
      }

      .search {
        justify-self: end;
      }

      .global-nav {
        display: none;
      }
    }

    @media (max-width: 49.99rem) {
      .search {
        width: 2.5rem;
      }
    }
  }
</style>
