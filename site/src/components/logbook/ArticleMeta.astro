---
import type { LogbookEntry } from "../../lib/logbook";

interface Props {
  doc: LogbookEntry;
}

const { doc } = Astro.props;
const kind = doc.kind === "case-study" ? "Case study" : doc.kind === "experiment" ? "Experiment" : "Method";
---

<div class={`article-meta accent-${doc.accent}`}>
  <span class="article-kind">{kind}</span>
  <span>{`${doc.section} · ${doc.readingMinutes} min read`}</span>
</div>

<style>
  .article-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 22px 0 16px;
    font: 500 14px/1.4 var(--sans);
    color: var(--ink-mute);
  }
  /* .accent-* → --doc-accent is the one accent translation, in theme.css. */
  .article-kind {
    color: var(--doc-accent);
    font-weight: 650;
  }
  @media (max-width: 520px) {
    .article-meta {
      flex-wrap: wrap;
      row-gap: 3px;
    }
  }
</style>
