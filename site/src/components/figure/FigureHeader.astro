---
interface Props {
  titleId: string;
  title: string;
  lesson?: string;
  headingLevel?: "h2" | "h3" | "h4";
}

const {
  titleId,
  title,
  lesson,
  headingLevel = "h3",
} = Astro.props;
const Heading = headingLevel;
---

<header class="meteo-gram-figure__header">
  <div class="meteo-gram-figure__heading-copy">
    <Heading id={titleId} class="meteo-gram-figure__title">{title}</Heading>
    {lesson && <p class="meteo-gram-figure__lesson">{lesson}</p>}
  </div>
</header>
