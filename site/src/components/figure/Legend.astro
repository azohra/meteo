---
export interface LegendItem {
  label: string;
  description?: string;
  color?: string;
  mark?: "line" | "dot" | "area";
}

interface Props {
  items: LegendItem[];
  label?: string;
}

const { items, label = "Figure legend" } = Astro.props;
---

<aside class="meteo-gram-legend" aria-label={label}>
  <span class="meteo-gram-legend__title">{label}</span>
  <ul>
    {items.map((item) => (
      <li>
        <span
          class:list={["meteo-gram-legend__mark", `meteo-gram-legend__mark--${item.mark ?? "line"}`]}
          style={item.color ? `--meteo-gram-legend-color: ${item.color}` : undefined}
          aria-hidden="true"
        ></span>
        <span>
          <strong>{item.label}</strong>
          {item.description && <span class="meteo-gram-legend__description">{item.description}</span>}
        </span>
      </li>
    ))}
  </ul>
</aside>
