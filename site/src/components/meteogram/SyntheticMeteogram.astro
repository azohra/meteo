---
import type { TeachingScenario } from "../../lib/scenarios";
import {
  renderSyntheticMeteogram,
  type InteractiveSyntheticMeteogramOptions,
  type SyntheticScenarioSource,
  type SyntheticMeteogramOptions,
} from "../../lib/example-meteogram";

type Props = InteractiveSyntheticMeteogramOptions & {
  scenario: TeachingScenario;
  idPrefix: string;
  /**
   * Embed the scenario's profile document inline so overlay controls in the
   * surrounding figure can rebuild the scene client-side. Static figures omit
   * it and ship only the server-rendered SVG.
   */
  interactive?: boolean;
  scrollLabel?: string;
  class?: string;
};

const {
  scenario,
  idPrefix,
  interactive = false,
  overlays,
  columnWidthPx,
  widthPx,
  plotHeightPx,
  hourLabel,
  barbStride,
  barbMinGapPx,
  barbScale,
  markerStride,
  stripLabels,
  displayDay = false,
  scrollLabel = `Scrollable Meteogram for ${scenario.label}`,
  class: className,
} = Astro.props;
const options: SyntheticMeteogramOptions = {
  ...(overlays ? { overlays } : {}),
  ...(columnWidthPx === undefined ? {} : { columnWidthPx }),
  ...(widthPx === undefined ? {} : { widthPx }),
  ...(plotHeightPx === undefined ? {} : { plotHeightPx }),
  ...(hourLabel === undefined ? {} : { hourLabel }),
  ...(barbStride === undefined ? {} : { barbStride }),
  ...(barbMinGapPx === undefined ? {} : { barbMinGapPx }),
  ...(barbScale === undefined ? {} : { barbScale }),
  ...(markerStride === undefined ? {} : { markerStride }),
  ...(stripLabels === undefined ? {} : { stripLabels }),
  displayDay,
};
const { scene, svg } = renderSyntheticMeteogram(scenario, options, idPrefix);
// The client script rebuilds from this embedded document rather than from
// the scenario registry, which stays server-only: each page ships exactly
// the profiles its own interactive figures embed.
const source: SyntheticScenarioSource | null = interactive
  ? {
      id: scenario.id,
      ...(scenario.variant === undefined ? {} : { variant: scenario.variant }),
      profile: scenario.profile,
      timeZone: scenario.timeZone,
      launch: scenario.launch,
    }
  : null;
const clientOptions = JSON.stringify({
  columnWidthPx,
  widthPx,
  plotHeightPx,
  hourLabel,
  barbStride,
  barbMinGapPx,
  barbScale,
  markerStride,
  stripLabels,
  displayDay,
});
const initialOverlays = JSON.stringify(overlays ?? {});
---

<div
  class:list={["synthetic-meteogram", className]}
  data-synthetic-meteogram
  data-scenario-id={scenario.id}
  data-id-prefix={idPrefix}
  data-scene-options={clientOptions}
  data-initial-overlays={initialOverlays}
  style={`--synthetic-meteogram-width: ${scene.width}px`}
>
  {source && (
    <script
      is:inline
      type="application/json"
      data-meteogram-source
      set:html={JSON.stringify(source)}
    />
  )}
  <div
    class="meteo-gram-scroll"
    role="region"
    tabindex="0"
    aria-label={scrollLabel}
  >
    <div
      class="synthetic-meteogram__mount"
      data-meteogram-mount
      set:html={svg}
    />
  </div>
  <p class="synthetic-meteogram__scroll-cue" aria-hidden="true">
    Scroll horizontally to inspect every hour →
  </p>
</div>

<script>
  import {
    renderSyntheticMeteogram,
    type InteractiveSyntheticMeteogramOptions,
    type SyntheticScenarioSource,
  } from "../../lib/example-meteogram";
  import type { OverlayName } from "@azohra/meteo.briefing/meteogram";

  for (const chart of document.querySelectorAll<HTMLElement>("[data-synthetic-meteogram]")) {
    if (chart.dataset.syntheticMeteogramReady === "true") continue;
    chart.dataset.syntheticMeteogramReady = "true";

    const mount = chart.querySelector<HTMLElement>("[data-meteogram-mount]");
    const figure = chart.closest<HTMLElement>("[data-figure]");
    const idPrefix = chart.dataset.idPrefix;
    if (!mount || !figure || !idPrefix) continue;

    const options = JSON.parse(
      chart.dataset.sceneOptions ?? "{}",
    ) as InteractiveSyntheticMeteogramOptions;
    const initial = JSON.parse(chart.dataset.initialOverlays ?? "{}") as Partial<Record<OverlayName, boolean>>;
    const controls = [...figure.querySelectorAll<HTMLInputElement>("input[data-meteogram-overlay]")];
    if (controls.length === 0) continue;

    const sourceElement = chart.querySelector<HTMLScriptElement>("[data-meteogram-source]");
    if (!sourceElement?.textContent) {
      throw new Error(
        `[synthetic-meteogram] ${idPrefix} has overlay controls but no embedded profile — render <SyntheticMeteogram interactive />`,
      );
    }
    const source = Object.freeze(
      JSON.parse(sourceElement.textContent),
    ) as Readonly<SyntheticScenarioSource>;

    const currentOverlays = () => ({
      ...initial,
      ...Object.fromEntries(
        controls.map((control) => [control.dataset.meteogramOverlay as OverlayName, control.checked]),
      ),
    });
    const rerender = () => {
      const rendered = renderSyntheticMeteogram(
        source,
        { ...options, overlays: currentOverlays() },
        idPrefix,
      );
      mount.innerHTML = rendered.svg;
      chart.dispatchEvent(new CustomEvent("meteogram:scenechange", {
        bubbles: true,
        detail: { idPrefix, scene: rendered.scene },
      }));
    };

    for (const control of controls) control.addEventListener("change", rerender);
    figure.addEventListener("figure:reset", rerender);
    figure.addEventListener("meteogram:keyrequest", (event) => {
      const requestedIdPrefix = (event as CustomEvent<{ idPrefix?: string }>).detail?.idPrefix;
      if (requestedIdPrefix === idPrefix) rerender();
    });

    // Publish the current browser state after listeners attach. Together with
    // the key's request below, this is a two-sided handshake: whichever
    // component initializes second synchronizes the pair, including restored
    // form state after back/forward navigation.
    rerender();
  }
</script>

<style>
  .synthetic-meteogram {
    min-width: 0;
    background: var(--surface);
  }

  .synthetic-meteogram__mount :global(svg) {
    display: block;
    width: var(--synthetic-meteogram-width);
    max-width: none;
    height: auto;
  }

  .synthetic-meteogram__scroll-cue {
    display: none;
    margin: 0;
    padding: 0.42rem 0.85rem;
    color: var(--ink-mute);
    background: var(--surface-raised);
    border-block-start: 1px solid var(--rule);
    font: 0.68rem/1.4 var(--mono);
  }

  @media (max-width: 44rem) {
    .synthetic-meteogram__scroll-cue {
      display: block;
    }
  }

  @media print {
    .synthetic-meteogram__mount :global(svg) {
      width: 100%;
      min-width: 0;
    }

    .synthetic-meteogram__scroll-cue {
      display: none;
    }
  }
</style>
