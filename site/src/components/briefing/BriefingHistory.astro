---
/* Every byte count, offset, and run stamp is read from the sample
   archive and its sidecar index by the package's reader (exhibit.ts);
   the two are cross-checked, so the panel fails the build before it
   could show a stale offset. */
import type { RunComparisonFindingKind } from "@azohra/meteo.briefing/history";
import { formatBytes } from "../../lib/forecast-exhibit";
import { sampleArchive } from "./exhibit";

const archive = sampleArchive();

/* compareRuns' kinds, checked against the package's own union so the
   list cannot gain or lose one silently. What each states is
   briefing/docs/history.md's to say; the link below goes there. */
const KIND_SET = {
  existenceTrajectory: true,
  timingTrajectory: true,
  magnitudeTrajectory: true,
  identityDrift: true,
  settled: true,
} satisfies Record<RunComparisonFindingKind, true>;
const KINDS = Object.keys(KIND_SET);
---

<section class="bf-history" aria-labelledby="briefing-history-title">
  <div class="bf-history-inner section-inner">
    <h2 id="briefing-history-title">Has the forecast settled?</h2>
    <p class="bf-section-lede">
      <code>compareRuns</code> lines up what each successive run said about
      the same local day, newest first. <code>loadForecastHistory</code> reads those runs from the month archive. Every engine build appends one
      gzip member to it and never rewrites existing bytes.
    </p>

    <div class="bf-history-grid">
      <figure class="bf-archive" id="briefing-archive">
        <div class="bf-term">
          <p class="bf-term-title">{archive.path} · {formatBytes(archive.bytes)}</p>
          <ul class="bf-archive-members">
            {archive.runs.map((run) => (
              <li>
                <span class="bf-archive-member__span">
                  gzip member @ byte {run.byteOffset} · {formatBytes(run.byteLength)} · {run.lines}{" "}
                  {run.lines === 1 ? "line" : "lines"}
                </span>
                <span class="bf-archive-member__run">
                  → {run.model} · run {run.referenceTime} · generated {run.generatedAt}
                </span>
                <span class="bf-archive-member__doc">
                  the whole published document: {run.siteName}, {run.hours} hours
                </span>
              </li>
            ))}
          </ul>
          <p class="bf-archive-index">
            sidecar {archive.indexPath} lists each member's byte offset and
            length, so a reader can fetch only the runs it is missing with a
            Range request. The sidecar is advisory; the archive is authoritative
          </p>
        </div>
        <figcaption class="bf-caption">
          {archive.runs.length === 1
            ? "One run so far this month. Each new build appends one more member."
            : `${archive.runs.length} runs this month, one member per build.`}
        </figcaption>
      </figure>

      <div class="bf-history-kinds">
        <h3>What <code>compareRuns</code> states</h3>
        <ul>
          {KINDS.map((kind) => (
            <li><code>{kind}</code></li>
          ))}
        </ul>
        <p class="bf-history-refusals">
          It reports the series and the arithmetic and leaves the
          interpretation to you. It does not say a forecast is "trending
          better", weight one run over another, or grade agreement. <a href="/docs/briefing/history/">History and run
          convergence</a> says what each kind states.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .bf-history {
    border-block-end: 1px solid var(--rule);
    background: color-mix(in srgb, var(--surface) 48%, transparent);
  }

  .bf-history-inner {
    padding-block: clamp(2.5rem, 5vw, 4rem);
  }

  .bf-history h2 {
    margin: 0;
    font-size: clamp(1.5rem, 3vw, 2rem);
    letter-spacing: -0.015em;
  }

  .bf-section-lede {
    max-width: 46rem;
    margin: 0.8rem 0 0;
    color: var(--ink-soft);
    line-height: 1.6;
  }

  .bf-history-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
    margin-top: clamp(1.5rem, 3vw, 2.25rem);
  }

  .bf-archive {
    min-width: 0;
    margin: 0;
    display: grid;
    gap: 0.55rem;
  }

  .bf-term {
    border-radius: var(--radius);
    background: var(--term-bg);
    border: 1px solid var(--term-border);
    overflow: hidden;
  }

  .bf-term-title {
    margin: 0;
    padding: 0.55rem 0.9rem;
    font: 600 0.74rem/1.4 var(--mono);
    color: var(--term-muted);
    border-block-end: 1px solid var(--term-border);
    overflow-wrap: anywhere;
  }

  .bf-archive-members {
    margin: 0;
    padding: 0.8rem 0.9rem;
    list-style: none;
    display: grid;
    gap: 0.7rem;
    font: 0.76rem/1.55 var(--mono);
    overflow-x: auto;
  }

  .bf-archive-members li {
    display: grid;
    gap: 0.1rem;
  }

  .bf-archive-member__span {
    color: var(--term-ink);
    font-weight: 600;
  }

  .bf-archive-member__run {
    color: var(--term-key);
  }

  .bf-archive-member__doc {
    color: var(--term-muted);
    font-style: italic;
  }

  .bf-archive-index {
    margin: 0;
    padding: 0.55rem 0.9rem 0.7rem;
    border-block-start: 1px dashed var(--term-border);
    font: 0.7rem/1.5 var(--mono);
    color: var(--term-muted);
  }

  .bf-archive-index code {
    color: var(--term-string);
    font-size: 1em;
  }

  .bf-caption {
    font-size: 0.86rem;
    color: var(--ink-mute);
    text-align: center;
    text-wrap: balance;
  }

  .bf-history-kinds h3 {
    margin: 0;
    font-size: 1.05rem;
    letter-spacing: -0.01em;
  }

  .bf-history-kinds h3 code {
    font-size: 0.92em;
  }

  .bf-history-kinds ul {
    display: grid;
    gap: 0.6rem;
    margin: 1.1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .bf-history-kinds li {
    padding-left: clamp(0.9rem, 2vw, 1.25rem);
    border-left: 1px solid var(--rule);
  }

  .bf-history-kinds li code {
    font: 600 0.8rem/1.5 var(--mono);
    color: var(--ink);
  }

  .bf-history-refusals {
    max-width: 40rem;
    margin: 1.4rem 0 0;
    font-size: 0.85rem;
    line-height: 1.55;
    color: var(--ink-mute);
  }

  @media (max-width: 58rem) {
    .bf-history-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
