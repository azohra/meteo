---
/* The comparison exhibit: compareForecasts over the controlled timing
   pair. Both plates render from the pair's committed profiles; the
   statements below interpolate the comparison's own findings — including
   the one it refuses to make (a timing spread only one member stated). */
import Figure from "../figure/Figure.astro";
import SyntheticMeteogram from "../meteogram/SyntheticMeteogram.astro";
import { TIMING_OVERLAYS } from "../../lib/labs";
import { clock, fail, timingComparison } from "./exhibit";

const { earlier, later, agreement, heights, directions, statedStart, votes } = timingComparison();

const panels = [earlier, later].map((scenario) => {
  const vote =
    votes.find((candidate) => candidate.model === scenario.variant) ??
    fail(`no window vote for the ${scenario.variant} member`);
  return { scenario, vote };
});

const peaks = heights.peaks.map((peak) => ({
  model: peak.model,
  aboveLaunchM: peak.peakLiftTopAboveLaunchM,
  at: clock(peak.at),
}));

interface StatementRow {
  kind: string;
  term: string;
  statement: string;
}

const statements: StatementRow[] = [
  {
    kind: "windowAgreement",
    term: "Window agreement",
    statement:
      `${agreement.voters} voters, unanimous — both members call a thermal window. ` +
      `Only ${statedStart.model} states a start the day can time: ${statedStart.at}. ` +
      `The other window's opening edge is clipped by its document's horizon, so it reads ` +
      `"open since at least" and stays out of the timing envelope — startSpreadHours is ` +
      `null, not a number no model stated.`,
  },
  {
    kind: "heightSpread",
    term: "Height spread",
    statement:
      `${heights.spreadM} m between the members' peak lifts — ` +
      peaks.map((peak) => `${peak.model} puts ${peak.aboveLaunchM} m above launch at ${peak.at}`).join("; ") +
      `. No mean, no consensus height: the spread is stated, weighting is yours.`,
  },
  {
    kind: "windDirectionSpread",
    term: "Direction spread",
    statement:
      `${directions.maxAngularSeparationDeg}° between the members' window-mean surface flows (` +
      directions.entries
        .map((entry) => `${entry.model} ${entry.directionDeg}° at ${entry.speedMps} m/s`)
        .join(", ") +
      `), across a ${directions.maxSeparation.elevationDeltaM} m model-ground delta.`,
  },
];
---

<section class="bf-compare" aria-labelledby="briefing-compare-title">
  <div class="bf-compare-inner section-inner">
    <h2 id="briefing-compare-title">Do the models agree?</h2>
    <p class="bf-section-lede">
      <code>compareForecasts</code> answers with statements, not a winner: it
      analyzes every model's document under your launch and thresholds, then
      reports where they agree and how far they spread. Here it reads two
      documents for the same day — the same development, two hours apart:
    </p>

    <Figure
      id="briefing-compare-plates"
      title="Two controlled development timings"
      lesson={earlier.lesson}
      description="Two synthetic profiles with matching daytime development shifted to earlier and later hours, rendered side by side from the comparison pair's documents."
      caption="One launch marker, one lift scale, two documents. The development matches; only its hours move."
      units="time UTC · altitude m MSL · thermal strength as shaded columns"
      scenario={earlier}
      headingLevel="h3"
      size="content"
      class="bf-compare-figure"
    >
      <div class="bf-compare-pair">
        {panels.map(({ scenario, vote }) => (
          <section class="bf-compare-panel" aria-label={scenario.label}>
            <header class="bf-compare-panel__head">
              <strong>{scenario.label}</strong>
              <span>
                window {vote.window}{vote.clipped ? " · open at the first published hour" : ` · start stated`} ·
                peak {vote.peakMps} m/s
              </span>
            </header>
            <SyntheticMeteogram
              {scenario}
              idPrefix={`briefing-timing-${scenario.variant}`}
              overlays={TIMING_OVERLAYS}
              columnWidthPx={56}
              plotHeightPx={300}
              scrollLabel={`Scrollable Meteogram for ${scenario.label}`}
            />
          </section>
        ))}
      </div>
    </Figure>

    <dl class="bf-compare-statements">
      {statements.map((row) => (
        <div>
          <dt>{row.term} <code>{row.kind}</code></dt>
          <dd>{row.statement}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .bf-compare {
    border-block-end: 1px solid var(--rule);
  }

  .bf-compare-inner {
    padding-block: clamp(2.5rem, 5vw, 4rem);
  }

  .bf-compare h2 {
    margin: 0;
    font-size: clamp(1.5rem, 3vw, 2rem);
    letter-spacing: -0.015em;
  }

  .bf-section-lede {
    max-width: 46rem;
    margin: 0.8rem 0 0;
    color: var(--ink-soft);
    line-height: 1.6;
  }

  .bf-compare-inner :global(.bf-compare-figure) {
    width: min(100%, 62rem);
    margin-inline: auto;
  }

  .bf-compare-pair {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 24rem), 1fr));
    gap: 1px;
    background: var(--rule);
  }

  .bf-compare-panel {
    min-width: 0;
    background: var(--surface);
  }

  .bf-compare-panel__head {
    display: grid;
    gap: 0.15rem;
    padding: 0.65rem 0.9rem;
    border-block-end: 1px solid var(--rule);
  }

  .bf-compare-panel__head strong {
    font: 700 0.82rem/1.3 var(--sans);
    color: var(--ink);
  }

  .bf-compare-panel__head span {
    font: 0.68rem/1.4 var(--mono);
    color: var(--ink-mute);
  }

  /* Plates centre inside their panels — a chart narrower than its column
     never hugs the left edge. */
  .bf-compare-panel :global(.synthetic-meteogram__mount) {
    display: grid;
    justify-items: center;
  }

  .bf-compare-statements {
    display: grid;
    gap: 1.1rem;
    max-width: 52rem;
    margin: 1.8rem 0 0;
  }

  .bf-compare-statements div {
    padding-left: clamp(0.9rem, 2vw, 1.25rem);
    border-left: 1px solid var(--rule);
  }

  .bf-compare-statements dt {
    font-weight: 650;
    font-size: 0.92rem;
    color: var(--ink);
  }

  .bf-compare-statements dt code {
    margin-left: 0.35rem;
    font: 500 0.75rem/1.5 var(--mono);
    color: var(--ink-mute);
  }

  .bf-compare-statements dd {
    margin: 0.25rem 0 0;
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--ink-mute);
  }
</style>
