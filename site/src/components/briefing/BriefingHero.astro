---
/* The card's numbers are analyzeForecast's own output over the exhibit
   day (exhibit.ts), so the card cannot drift from what the package said. */
import { briefingDay, clock, DAY_WIND_CEILINGS, fail } from "./exhibit";

const { analysis, window, ceiling } = briefingDay();
const segment = ceiling.segments[0] ?? fail("the hero finding lost its segment");
const launchM = analysis.site.launchAltitudeM ?? fail("the hero analysis ran without a launch");
const bandExceedance =
  analysis.findings.find(
    (finding) => finding.kind === "windExceedance" && finding.quantity === "bandWind",
  ) ?? fail("the hero day emits no band-wind exceedance");
if (bandExceedance.kind !== "windExceedance") fail("unreachable");
const exceedanceRun = bandExceedance.runs[0] ?? fail("the exceedance finding carries no runs");

const briefingLines = [
  {
    term: "Thermal window",
    statement: `${clock(window.start)}–${clock(window.end)} · peak climb ${window.peakThermalVelocityMps} m/s`,
  },
  {
    term: "Lift ceiling",
    statement: `${segment.evidence.peakUsableLiftTopM} m, pinned to cloud base, under a boundary layer reaching ${segment.evidence.boundaryLayerTopM} m`,
  },
  {
    term: "Wind check",
    statement: `over your ${DAY_WIND_CEILINGS.bandMps} m/s limit ${clock(exceedanceRun.start)}–${clock(exceedanceRun.end)}, peaking ${exceedanceRun.peakMps} m/s`,
  },
];

const DOC_LINKS = [
  { label: "Analyze", href: "/docs/briefing/analyze/" },
  { label: "Compare", href: "/docs/briefing/compare/" },
  { label: "History", href: "/docs/briefing/history/" },
  { label: "Contract", href: "/docs/briefing/contract/" },
  { label: "Reading a Meteogram", href: "/docs/briefing/reading-a-meteogram/" },
];
---

<header class="bf-hero" aria-labelledby="briefing-title">
  <div class="bf-hero-inner section-inner">
    <div class="bf-hero-grid">
      <div class="bf-hero-copy">
        <h1 id="briefing-title">Turn published forecasts into briefings</h1>
        <div class="band-rule" aria-hidden="true"></div>
        <p class="bf-lede">
          Point <code>@azohra/meteo.briefing</code> at a published forecast
          and get back answers you can put in front of pilots: when the day
          works, how high it goes, whether the wind crosses your limits:
          typed data your site renders its own way, plus the Meteogram when
          the answer should be a chart.
        </p>
      </div>
      <figure class="bf-hero-panel" id="briefing-finding">
        <div class="bf-brief-card">
          <p class="bf-brief-card__title">
            {clock(window.start)}–{clock(window.end)} · launch {launchM} m
          </p>
          <dl class="bf-brief-card__lines">
            {
              briefingLines.map((line) => (
                <div>
                  <dt>{line.term}</dt>
                  <dd>{line.statement}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </figure>
    </div>
    <nav class="bf-docrail" aria-label="Briefing documentation">
      <span class="bf-docrail-label">Documentation</span>
      {DOC_LINKS.map(({ label, href }) => <a href={href}>{label}</a>)}
    </nav>
  </div>
</header>

<style>
  .bf-hero {
    background: var(--surface);
    border-block-end: 1px solid var(--rule);
  }

  .bf-hero-inner {
    padding-block: clamp(2.75rem, 6vw, 4.5rem) clamp(1.5rem, 3vw, 2rem);
  }

  .bf-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    column-gap: clamp(2.5rem, 6vw, 4.5rem);
    align-items: center;
  }

  .bf-hero h1 {
    max-width: 18ch;
    margin: 0 0 0.9rem;
    font-size: clamp(2.1rem, 4.6vw, 3.1rem);
    line-height: 1.08;
    letter-spacing: -0.022em;
  }

  .bf-lede {
    max-width: 36rem;
    margin: 1.1rem 0 0;
    font-size: 1.02rem;
    line-height: 1.65;
    color: var(--ink-soft, var(--ink));
  }

  .bf-lede--quiet {
    font-size: 0.88rem;
    color: var(--ink-mute);
  }

  .bf-lede code {
    font-size: 0.92em;
  }

  .bf-hero-panel {
    min-width: 0;
    margin: 0;
    display: grid;
    gap: 0.55rem;
  }

  /* The briefing card: what a pilot reads on the consumer's site. */
  .bf-brief-card {
    background: var(--surface-raised);
    border: 1px solid var(--rule);
    border-top: 3px solid var(--accent);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    overflow: hidden;
  }

  .bf-brief-card__title {
    margin: 0;
    padding: 0.7rem 1.1rem;
    font: 600 0.7rem/1.4 var(--mono);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--ink-mute);
    border-block-end: 1px solid var(--rule);
  }

  .bf-brief-card__lines {
    display: grid;
    gap: 0.9rem;
    margin: 0;
    padding: 1.1rem;
  }

  .bf-brief-card__lines dt {
    font: 700 0.72rem/1.4 var(--mono);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .bf-brief-card__lines dd {
    margin: 0.15rem 0 0;
    font-size: 1.02rem;
    line-height: 1.45;
    color: var(--ink);
  }

  .bf-caption {
    font-size: 0.82rem;
    font-style: italic;
    color: var(--ink-mute);
    text-align: center;
    text-wrap: balance;
  }

  .bf-caption code {
    font-style: normal;
    font-size: 0.95em;
  }

  .bf-docrail {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 1.2rem;
    margin-top: clamp(1.75rem, 3.5vw, 2.5rem);
    padding-top: 1rem;
    border-top: 1px solid var(--rule);
  }

  .bf-docrail-label {
    margin-inline-end: 0.4rem;
    font: 600 0.66rem/1.6 var(--mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-mute);
  }

  .bf-docrail a {
    color: var(--ink-soft);
    font-size: 0.8rem;
    font-weight: 600;
  }

  .bf-docrail a:hover {
    color: var(--accent);
    text-decoration: none;
  }

  @media (max-width: 900px) {
    .bf-hero-grid {
      grid-template-columns: 1fr;
      row-gap: 2rem;
    }
  }
</style>
