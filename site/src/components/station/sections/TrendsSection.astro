<section class="station-section" id="trends" aria-labelledby="trends-title">
  <h2 id="trends-title">Trends</h2>
  <p class="station-note">
    Temperature and sea-level pressure over the window; the
    20-minute dropout breaks both traces, never interpolated over.
  </p>
  <div class="station-grid station-grid-charts">
    <div class="station-panel">
      <h3>Temperature: Launch Ridge</h3>
      <meteo-trend-chart series="temperature" station-id="launch-ridge"></meteo-trend-chart>
    </div>
    <div class="station-panel">
      <h3>Pressure: Launch Ridge</h3>
      <meteo-trend-chart series="pressure" station-id="launch-ridge"></meteo-trend-chart>
    </div>
  </div>
</section>
