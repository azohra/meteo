{
  "name": "meteo-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run build:deps && astro dev",
    "build": "pnpm run build:deps && astro build",
    "build:deps": "pnpm --dir ../core build && pnpm --dir ../briefing build && pnpm --dir ../station build",
    "preview": "astro preview",
    "check": "pnpm run build:deps && astro check",
    "test": "pnpm run build && pnpm run test:built",
    "test:built": "playwright test"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/starlight": "^0.41.7",
    "@azohra/meteo.briefing": "workspace:*",
    "@azohra/meteo.core": "workspace:*",
    "@azohra/meteo.station": "workspace:*",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "astro": "^7.2.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.121.0"
  }
}
