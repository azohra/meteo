        "field": "levels.windSpeedMps",
        "hour": 0,
        "level": {
          "nearestHeightM": 1100
        }
      },
      "operator": "less-than-or-equal",
      "expected": 3.1
    },
    {
      "id": "climb-band-wind-gentle-at-peak",
      "description": "The wind nearest the cloud-base lift top stays at or below 5.6 m/s (20 km/h) at peak heating - a flyable climb, not a wind story.",
      "actual": {
        "field": "levels.windSpeedMps",
        "hour": 3,
        "level": {
          "nearestHeightM": 2100
        }
      },
      "operator": "less-than-or-equal",
      "expected": 5.6
    },
    {
      "id": "column-top-wind-believable",
      "description": "The 600 hPa wind stays at or below 7.5 m/s (27 km/h) at peak heating - no synthetic gale above the capped climb.",
      "actual": {
        "field": "levels.windSpeedMps",
        "hour": 3,
        "level": {
          "pressureHpa": 600
        }
      },
      "operator": "less-than-or-equal",
      "expected": 7.5
    },
    {
      "id": "evening-surface-wind-crosses-six",
      "description": "The evening valley wind carries the surface past a 6 m/s ceiling in the day's final hour - the briefing exhibit's surface exceedance.",
      "actual": {
        "field": "surface.windSpeedMps",
        "hour": 5
      },
      "operator": "greater-than-or-equal",
      "expected": 6
    },
    {
      "id": "evening-band-wind-crosses-eight",
      "description": "The shallow evening jet at launch height carries the climb band past an 8 m/s ceiling in the day's final hour - the briefing exhibit's band exceedance.",
      "actual": {
        "field": "levels.windSpeedMps",
        "hour": 5,
        "level": {
          "nearestHeightM": 1125
        }
      },
      "operator": "greater-than-or-equal",
      "expected": 8
    },
    {
      "id": "midday-surface-stays-under-ceiling",
      "description": "Through peak heating the surface wind stays below the 6 m/s ceiling, so the exceedance is an evening event, not the whole day.",
      "actual": {
        "field": "surface.windSpeedMps",
        "hour": 3
      },
      "operator": "less-than",
      "expected": 6
    }
