{
  "$schema": "../scenario.schema.json",
  "schemaVersion": 1,
  "id": "convective-cycle",
  "title": "A complete fair-weather convective cycle",
  "lesson": "Morning stability gives way to a deep midday unstable column. The boundary layer, usable lift, and cloud base follow distinct arcs beneath light wind that veers gently and gains only a few km/h with height.",
  "kind": "deterministic",
  "modelShape": "hourly-rich",
  "timeZone": "Etc/UTC",
  "site": {
    "id": "synthetic-ridge",
    "name": "Synthetic Ridge",
    "synthetic": true,
    "latitude": 49,
    "longitude": -123,
    "modelElevationM": 900
  },
  "launch": {
    "elevationM": 1050
  },
  "clock": {
    "referenceTime": "2000-01-01T06:00:00Z",
    "generatedAt": "2000-01-01T06:00:00Z",
    "startAt": "2000-01-01T10:00:00Z",
    "stepHours": 1,
    "hourCount": 10,
    "seed": 14001
  },
  "baseline": {
    "type": "synthetic",
    "path": "baselines/convective-cycle.source.json"
  },
  "transforms": [],
  "semantics": {
    "gust": "hourMax",
    "precipitation": "instantRate"
  },
  "capabilities": {
    "levels": true,
    "pressureLevels": [
      925,
      900,
      850,
      800,
      750,
      700,
      650,
      600
    ],
    "verticalVelocity": false,
    "heatFluxes": true,
    "gust": "hourMax",
    "cape": true,
    "cin": true,
    "pblHeight": true,
    "cloudLayers": true,
    "cloudProfile": false
  },
  "assertions": [
    {
      "id": "morning-column-contained",
      "description": "The boundary-layer top rises above its morning height by midday.",
      "actual": {
        "field": "derived.boundaryLayerTopM",
        "hour": 0
      },
      "operator": "less-than",
      "expected": {
        "field": "derived.boundaryLayerTopM",
        "hour": 5
      }
    },
    {
      "id": "mixed-layer-peaks-midday",
      "description": "The boundary-layer top falls after its midday maximum.",
      "actual": {
        "field": "derived.boundaryLayerTopM",
        "hour": 5
      },
      "operator": "greater-than",
      "expected": {
        "field": "derived.boundaryLayerTopM",
        "hour": 6
      }
    },
    {
      "id": "usable-lift-appears",
      "description": "Peak heating produces usable lift after the no-lift morning.",
      "actual": {
        "field": "derived.usableLiftTopM",
        "hour": 5
      },
      "operator": "present"
    },
    {
      "id": "usable-lift-decays",
      "description": "The usable-lift top falls after peak surface heating.",
      "actual": {
        "field": "derived.usableLiftTopM",
        "hour": 6
      },
      "operator": "less-than",
      "expected": {
        "field": "derived.usableLiftTopM",
        "hour": 5
      }
    },
    {
      "id": "evening-heating-ends",
      "description": "Negative evening heat flux reduces the derived thermal velocity to zero.",
      "actual": {
        "field": "derived.thermalVelocityMps",
        "hour": 9
      },
      "operator": "equal",
      "expected": 0
    },
    {
      "id": "cloud-base-rises",
      "description": "The drier heated surface raises cloud base above its morning height.",
      "actual": {
        "field": "derived.cloudBaseM",
        "hour": 5
      },
      "operator": "greater-than",
      "expected": {
        "field": "derived.cloudBaseM",
        "hour": 0
      }
    },
    {
      "id": "cape-follows-the-heating-cycle",
      "description": "Surface CAPE rises from 320 to 780 J/kg as the midday column deepens.",
      "actual": {
        "field": "surface.capeJkg",
        "hour": 5
      },
      "operator": "greater-than",
      "expected": {
        "field": "surface.capeJkg",
        "hour": 4
      }
    },
    {
      "id": "cape-remains-moderate",
      "description": "Peak surface CAPE stays at or below 800 J/kg.",
      "actual": {
        "field": "surface.capeJkg",
        "hour": 5
      },
      "operator": "less-than-or-equal",
      "expected": 800
    },
    {
      "id": "cape-fades-after-peak",
      "description": "Surface CAPE falls from 780 to 440 J/kg after the peak.",
      "actual": {
        "field": "surface.capeJkg",
        "hour": 6
      },
      "operator": "less-than",
      "expected": {
        "field": "surface.capeJkg",
        "hour": 5
      }
    },
    {
      "id": "inhibition-weakens-midday",
      "description": "Surface CIN weakens from -35 to -5 J/kg as the midday column deepens.",
      "actual": {
        "field": "surface.cinJkg",
        "hour": 5
      },
      "operator": "greater-than",
      "expected": {
        "field": "surface.cinJkg",
        "hour": 4
      }
    },
    {
      "id": "column-speed-gain-bounded",
      "description": "Fair weather means no strong speed shear: midday wind at 600 hPa exceeds the surface wind by no more than 4.5 m/s.",
      "actual": {
        "field": "levels.windSpeedMps",
        "hour": 5,
        "level": {
          "pressureHpa": 600
        }
      },
      "operator": "less-than-or-equal",
      "expected": {
        "field": "surface.windSpeedMps",
        "hour": 5
      },
      "tolerance": 4.5
    },
    {
      "id": "column-veers-modestly",
      "description": "The barb-reading lesson survives: midday wind still turns at least 30 degrees between the surface and 600 hPa.",
      "actual": {
        "field": "levels.windDirectionDeg",
        "hour": 5,
        "level": {
          "pressureHpa": 600
        }
      },
      "operator": "absolute-difference-at-least",
      "expected": {
        "field": "surface.windDirectionDeg",
        "hour": 5
      },
      "threshold": 30
    },
    {
      "id": "column-veer-bounded",
      "description": "No strong directional shear: the midday surface-to-600 hPa veer stays within 70 degrees (directions are monotonic in height and never wrap north).",
      "actual": {
        "field": "levels.windDirectionDeg",
        "hour": 5,
        "level": {
          "pressureHpa": 600
        }
      },
      "operator": "less-than-or-equal",
      "expected": {
        "field": "surface.windDirectionDeg",
        "hour": 5
      },
      "tolerance": 70
    },
    {
      "id": "launch-wind-light-at-window-open",
      "description": "The wind nearest launch height stays at or below 4.2 m/s (15 km/h) as the flying window opens at 12:00.",
      "actual": {
        "field": "levels.windSpeedMps",
        "hour": 2,
        "level": {
          "nearestHeightM": 1100
        }
      },
      "operator": "less-than-or-equal",
      "expected": 4.2
    },
    {
      "id": "launch-wind-light-at-peak",
      "description": "The wind nearest launch height stays at or below 4.2 m/s (15 km/h) at peak heating.",
      "actual": {
        "field": "levels.windSpeedMps",
        "hour": 5,
        "level": {
          "nearestHeightM": 1100
        }
      },
      "operator": "less-than-or-equal",
      "expected": 4.2
    },
    {
      "id": "launch-wind-light-at-window-close",
      "description": "The wind nearest launch height stays at or below 4.2 m/s (15 km/h) as the flying window closes at 17:00.",
      "actual": {
        "field": "levels.windSpeedMps",
        "hour": 7,
        "level": {
          "nearestHeightM": 1100
        }
      },
      "operator": "less-than-or-equal",
      "expected": 4.2
    },
    {
      "id": "gusts-soarable-at-peak",
      "description": "Peak-heating gusts stay at or below 6.4 m/s (23 km/h) - thermic cycles, not a blown-out day.",
      "actual": {
        "field": "surface.windGustMps",
        "hour": 5
      },
      "operator": "less-than-or-equal",
      "expected": 6.4
    },
    {
      "id": "gusts-soarable-after-peak",
      "description": "Gusts remain at or below 6.4 m/s (23 km/h) through the hour after peak heating.",
      "actual": {
        "field": "surface.windGustMps",
        "hour": 6
      },
      "operator": "less-than-or-equal",
      "expected": 6.4
    },
    {
      "id": "lift-band-top-wind-gentle",
      "description": "The wind nearest the top of the midday usable-lift band stays at or below 6.9 m/s (25 km/h).",
      "actual": {
        "field": "levels.windSpeedMps",
        "hour": 5,
        "level": {
          "nearestHeightM": 3150
        }
      },
      "operator": "less-than-or-equal",
      "expected": 6.9
    },
    {
      "id": "lift-top-strong-but-believable",
      "description": "The peak usable-lift top sits between 2800 and 3300 m MSL - a strong interior day, not an epic outlier.",
      "actual": {
        "field": "derived.usableLiftTopM",
        "hour": 5
      },
      "operator": "less-than-or-equal",
      "expected": 3300
    },
    {
      "id": "lift-top-reaches-a-strong-day",
      "description": "The peak usable-lift top still reaches at least 2800 m MSL, keeping the deep-column lesson.",
      "actual": {
        "field": "derived.usableLiftTopM",
        "hour": 5
      },
      "operator": "greater-than-or-equal",
      "expected": 2800
    },
    {
      "id": "cloud-base-believable",
      "description": "The peak cloud base stays at or below 3800 m MSL, in reach of the lift band rather than an epic outlier.",
      "actual": {
        "field": "derived.cloudBaseM",
        "hour": 5
      },
      "operator": "less-than-or-equal",
      "expected": 3800
    }
  ]
}
