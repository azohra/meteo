{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meteo.azohra.com/scenarios/index.schema.json",
  "title": "Synthetic scenario index",
  "description": "The public index of generated teaching scenarios (scenarios/index.json), emitted by `meteo forecast scenarios generate` and consumed by the site's scenario registry. Every entry pairs a definition's teaching metadata with the generated profiles' provenance (path + SHA-256), the representative profile's site block, and the launch renderers pass as MeteogramOptions.launch.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "scenarios"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "scenarios": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/scenario"
      }
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 1,
      "maxLength": 80
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "lesson",
        "kind",
        "modelShape",
        "timeZone",
        "site",
        "launch",
        "capabilities",
        "outputs"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "lesson": {
          "type": "string",
          "minLength": 20,
          "maxLength": 500
        },
        "kind": {
          "enum": [
            "deterministic",
            "ensemble",
            "comparison"
          ]
        },
        "modelShape": {
          "enum": [
            "hourly-rich",
            "hourly-core",
            "three-hourly-regional",
            "ensemble-five-level"
          ]
        },
        "timeZone": {
          "description": "An explicit IANA-style time-zone name, echoed from the definition.",
          "type": "string",
          "pattern": "^(?:Etc/(?:UTC|GMT(?:[+-](?:[1-9]|1[0-4]))?)|[A-Za-z]+(?:[_-][A-Za-z]+)*(?:/[A-Za-z]+(?:[_-][A-Za-z]+)*)+)$"
        },
        "site": {
          "$ref": "#/$defs/site"
        },
        "launch": {
          "$ref": "#/$defs/launch"
        },
        "capabilities": {
          "$ref": "#/$defs/capabilities"
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/output"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "comparison"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "outputs": {
                "minItems": 2,
                "items": {
                  "required": [
                    "variant",
                    "title",
                    "path",
                    "sha256"
                  ]
                }
              }
            }
          },
          "else": {
            "properties": {
              "outputs": {
                "maxItems": 1,
                "items": {
                  "not": {
                    "required": [
                      "variant"
                    ]
                  }
                }
              }
            }
          }
        }
      ]
    },
    "site": {
      "description": "The representative generated profile's site block, verbatim — sample provenance, never a launch.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "latitude",
        "longitude",
        "modelElevationM"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "modelElevationM": {
          "type": "number",
          "minimum": -500,
          "maximum": 9000
        },
        "timeZone": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "launch": {
      "description": "The launch the scenario teaches against. It never enters the generated documents (documents are launch-agnostic sample provenance); renderers pass it as MeteogramOptions.launch, the same seam production consumers use.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "elevationM"
      ],
      "properties": {
        "elevationM": {
          "type": "number",
          "minimum": -500,
          "maximum": 9000
        }
      }
    },
    "capabilities": {
      "description": "The definition's capability declaration, verbatim — the same shape scenario.schema.json's capabilities block validates.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "levels",
        "pressureLevels",
        "verticalVelocity",
        "heatFluxes",
        "gust",
        "cape",
        "cin",
        "pblHeight",
        "cloudLayers",
        "cloudProfile"
      ],
      "properties": {
        "levels": {
          "type": "boolean"
        },
        "pressureLevels": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "number",
            "minimum": 50,
            "maximum": 1100
          }
        },
        "verticalVelocity": {
          "oneOf": [
            {
              "const": false
            },
            {
              "enum": [
                "omega",
                "fromGeometricW"
              ]
            }
          ]
        },
        "verticalVelocityLevels": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "number",
            "minimum": 50,
            "maximum": 1100
          }
        },
        "heatFluxes": {
          "type": "boolean"
        },
        "gust": {
          "oneOf": [
            {
              "const": false
            },
            {
              "enum": [
                "hourMax",
                "instant"
              ]
            }
          ]
        },
        "cape": {
          "type": "boolean"
        },
        "cin": {
          "type": "boolean"
        },
        "pblHeight": {
          "type": "boolean"
        },
        "cloudLayers": {
          "type": "boolean"
        },
        "cloudProfile": {
          "type": "boolean"
        },
        "smoke": {
          "oneOf": [
            {
              "const": false
            },
            {
              "enum": [
                "radiativelyCoupled",
                "passive"
              ]
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "levels": {
                "const": false
              }
            },
            "required": [
              "levels"
            ]
          },
          "then": {
            "properties": {
              "pressureLevels": {
                "maxItems": 0
              },
              "verticalVelocity": {
                "const": false
              },
              "cloudProfile": {
                "const": false
              }
            }
          },
          "else": {
            "properties": {
              "pressureLevels": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "verticalVelocity": {
                "const": false
              }
            },
            "required": [
              "verticalVelocity"
            ]
          },
          "then": {
            "not": {
              "required": [
                "verticalVelocityLevels"
              ]
            }
          },
          "else": {
            "required": [
              "verticalVelocityLevels"
            ]
          }
        }
      ]
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "variant": {
          "$ref": "#/$defs/slug"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "path": {
          "description": "The generated profile document, relative to scenarios/.",
          "type": "string",
          "pattern": "^generated/[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)?\\.profile\\.json$"
        },
        "sha256": {
          "description": "Lowercase SHA-256 of the generated document's bytes.",
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
