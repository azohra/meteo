{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meteo.azohra.com/scenarios/index.schema.json",
  "title": "Synthetic scenario index",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "scenarios": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "lesson": {
                "type": "string",
                "minLength": 20,
                "maxLength": 500
              },
              "kind": {
                "type": "string",
                "enum": [
                  "deterministic",
                  "ensemble"
                ]
              },
              "modelShape": {
                "type": "string",
                "enum": [
                  "hourly-rich",
                  "hourly-core",
                  "three-hourly-regional",
                  "ensemble-five-level"
                ]
              },
              "timeZone": {
                "type": "string",
                "pattern": "^(?:Etc\\/(?:UTC|GMT(?:[+-](?:[1-9]|1[0-4]))?)|[A-Za-z]+(?:[_-][A-Za-z]+)*(?:\\/[A-Za-z]+(?:[_-][A-Za-z]+)*)+)$",
                "description": "An explicit IANA-style time-zone name, echoed from the definition."
              },
              "site": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80,
                    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "latitude": {
                    "type": "number",
                    "minimum": -90,
                    "maximum": 90
                  },
                  "longitude": {
                    "type": "number",
                    "minimum": -180,
                    "maximum": 180
                  },
                  "modelElevationM": {
                    "type": "number",
                    "minimum": -500,
                    "maximum": 9000
                  },
                  "timeZone": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "id",
                  "name",
                  "latitude",
                  "longitude",
                  "modelElevationM"
                ],
                "additionalProperties": false,
                "description": "The representative generated profile's site block, verbatim — sample provenance, never a launch."
              },
              "launch": {
                "type": "object",
                "properties": {
                  "elevationM": {
                    "type": "number",
                    "minimum": -500,
                    "maximum": 9000
                  }
                },
                "required": [
                  "elevationM"
                ],
                "additionalProperties": false,
                "description": "The launch the scenario teaches against. It never enters the generated documents (documents are launch-agnostic sample provenance); renderers pass it as MeteogramOptions.launch, the same seam production consumers use."
              },
              "capabilities": {
                "type": "object",
                "properties": {
                  "levels": {
                    "type": "boolean"
                  },
                  "pressureLevels": {
                    "type": "array",
                    "items": {
                      "type": "number",
                      "minimum": 50,
                      "maximum": 1100
                    }
                  },
                  "verticalVelocity": {
                    "anyOf": [
                      {
                        "type": "boolean",
                        "const": false
                      },
                      {
                        "type": "string",
                        "enum": [
                          "omega",
                          "fromGeometricW"
                        ]
                      }
                    ]
                  },
                  "verticalVelocityLevels": {
                    "type": "array",
                    "items": {
                      "type": "number",
                      "minimum": 50,
                      "maximum": 1100
                    }
                  },
                  "heatFluxes": {
                    "type": "boolean"
                  },
                  "gust": {
                    "anyOf": [
                      {
                        "type": "boolean",
                        "const": false
                      },
                      {
                        "type": "string",
                        "enum": [
                          "hourMax",
                          "instant"
                        ]
                      }
                    ]
                  },
                  "cape": {
                    "type": "boolean"
                  },
                  "cin": {
                    "type": "boolean"
                  },
                  "pblHeight": {
                    "type": "boolean"
                  },
                  "cloudLayers": {
                    "type": "boolean"
                  },
                  "cloudProfile": {
                    "type": "boolean"
                  },
                  "smoke": {
                    "anyOf": [
                      {
                        "type": "boolean",
                        "const": false
                      },
                      {
                        "type": "string",
                        "enum": [
                          "radiativelyCoupled",
                          "passive"
                        ]
                      }
                    ]
                  }
                },
                "required": [
                  "levels",
                  "pressureLevels",
                  "verticalVelocity",
                  "heatFluxes",
                  "gust",
                  "cape",
                  "cin",
                  "pblHeight",
                  "cloudLayers",
                  "cloudProfile"
                ],
                "additionalProperties": false,
                "description": "The definition's capability declaration, verbatim — the same shape scenario.schema.json's capabilities block validates."
              },
              "outputs": {
                "minItems": 1,
                "maxItems": 1,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "title": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "path": {
                      "type": "string",
                      "pattern": "^generated\\/[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)?\\.profile\\.json$",
                      "description": "The generated profile document, relative to scenarios/."
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$",
                      "description": "Lowercase SHA-256 of the generated document's bytes."
                    }
                  },
                  "required": [
                    "path",
                    "sha256"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "id",
              "title",
              "lesson",
              "kind",
              "modelShape",
              "timeZone",
              "site",
              "launch",
              "capabilities",
              "outputs"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "lesson": {
                "type": "string",
                "minLength": 20,
                "maxLength": 500
              },
              "kind": {
                "type": "string",
                "const": "comparison"
              },
              "modelShape": {
                "type": "string",
                "enum": [
                  "hourly-rich",
                  "hourly-core",
                  "three-hourly-regional",
                  "ensemble-five-level"
                ]
              },
              "timeZone": {
                "type": "string",
                "pattern": "^(?:Etc\\/(?:UTC|GMT(?:[+-](?:[1-9]|1[0-4]))?)|[A-Za-z]+(?:[_-][A-Za-z]+)*(?:\\/[A-Za-z]+(?:[_-][A-Za-z]+)*)+)$",
                "description": "An explicit IANA-style time-zone name, echoed from the definition."
              },
              "site": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80,
                    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "latitude": {
                    "type": "number",
                    "minimum": -90,
                    "maximum": 90
                  },
                  "longitude": {
                    "type": "number",
                    "minimum": -180,
                    "maximum": 180
                  },
                  "modelElevationM": {
                    "type": "number",
                    "minimum": -500,
                    "maximum": 9000
                  },
                  "timeZone": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "id",
                  "name",
                  "latitude",
                  "longitude",
                  "modelElevationM"
                ],
                "additionalProperties": false,
                "description": "The representative generated profile's site block, verbatim — sample provenance, never a launch."
              },
              "launch": {
                "type": "object",
                "properties": {
                  "elevationM": {
                    "type": "number",
                    "minimum": -500,
                    "maximum": 9000
                  }
                },
                "required": [
                  "elevationM"
                ],
                "additionalProperties": false,
                "description": "The launch the scenario teaches against. It never enters the generated documents (documents are launch-agnostic sample provenance); renderers pass it as MeteogramOptions.launch, the same seam production consumers use."
              },
              "capabilities": {
                "type": "object",
                "properties": {
                  "levels": {
                    "type": "boolean"
                  },
                  "pressureLevels": {
                    "type": "array",
                    "items": {
                      "type": "number",
                      "minimum": 50,
                      "maximum": 1100
                    }
                  },
                  "verticalVelocity": {
                    "anyOf": [
                      {
                        "type": "boolean",
                        "const": false
                      },
                      {
                        "type": "string",
                        "enum": [
                          "omega",
                          "fromGeometricW"
                        ]
                      }
                    ]
                  },
                  "verticalVelocityLevels": {
                    "type": "array",
                    "items": {
                      "type": "number",
                      "minimum": 50,
                      "maximum": 1100
                    }
                  },
                  "heatFluxes": {
                    "type": "boolean"
                  },
                  "gust": {
                    "anyOf": [
                      {
                        "type": "boolean",
                        "const": false
                      },
                      {
                        "type": "string",
                        "enum": [
                          "hourMax",
                          "instant"
                        ]
                      }
                    ]
                  },
                  "cape": {
                    "type": "boolean"
                  },
                  "cin": {
                    "type": "boolean"
                  },
                  "pblHeight": {
                    "type": "boolean"
                  },
                  "cloudLayers": {
                    "type": "boolean"
                  },
                  "cloudProfile": {
                    "type": "boolean"
                  },
                  "smoke": {
                    "anyOf": [
                      {
                        "type": "boolean",
                        "const": false
                      },
                      {
                        "type": "string",
                        "enum": [
                          "radiativelyCoupled",
                          "passive"
                        ]
                      }
                    ]
                  }
                },
                "required": [
                  "levels",
                  "pressureLevels",
                  "verticalVelocity",
                  "heatFluxes",
                  "gust",
                  "cape",
                  "cin",
                  "pblHeight",
                  "cloudLayers",
                  "cloudProfile"
                ],
                "additionalProperties": false,
                "description": "The definition's capability declaration, verbatim — the same shape scenario.schema.json's capabilities block validates."
              },
              "outputs": {
                "minItems": 2,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "variant": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80,
                      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                    },
                    "title": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "path": {
                      "type": "string",
                      "pattern": "^generated\\/[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)?\\.profile\\.json$",
                      "description": "The generated profile document, relative to scenarios/."
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$",
                      "description": "Lowercase SHA-256 of the generated document's bytes."
                    }
                  },
                  "required": [
                    "variant",
                    "title",
                    "path",
                    "sha256"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "id",
              "title",
              "lesson",
              "kind",
              "modelShape",
              "timeZone",
              "site",
              "launch",
              "capabilities",
              "outputs"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "scenarios"
  ],
  "additionalProperties": false,
  "description": "The public index of generated teaching scenarios (scenarios/index.json), emitted by `pnpm scenarios:generate` and consumed by the site's scenario registry. Every entry pairs a definition's teaching metadata with the generated profiles' provenance (path + SHA-256), the representative profile's site block, and the launch renderers pass as MeteogramOptions.launch."
}
