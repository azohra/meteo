{
  "name": "@azohra/meteo.core",
  "version": "0.2.0",
  "description": "Units, angles, and wind-vector math shared by the meteo packages, with one sign convention platform-wide, plus zod schema primitives, the upstream-failure vocabulary, and schema-artifact rendering.",
  "keywords": [
    "weather",
    "meteorology",
    "units",
    "si-units",
    "zod",
    "schema"
  ],
  "author": "Justin Watts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/azohra/meteo.git",
    "directory": "core"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "test": "vp test",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "homepage": "https://meteo.azohra.com"
}
