{
  "name": "@azohra/meteo.core",
  "version": "0.1.1",
  "description": "The foundation of meteo by Azohra: the shared physical vocabulary every platform package builds on - units and conversions, angles, the platform's one wind sign convention, zod schema primitives, upstream-failure vocabulary, and the schema-artifact rendering machinery.",
  "keywords": [
    "weather",
    "meteorology",
    "units",
    "si-units",
    "zod",
    "schema"
  ],
  "author": "Justin Watts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/azohra/meteo.git",
    "directory": "core"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "test": "vp test",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "homepage": "https://meteo.azohra.com"
}
