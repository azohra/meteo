#!/bin/sh
# The full battery, at the moment a commit forms (~25 s: internal/gates.mjs).
# On green, record the proven tree so pre-push can skip honestly: the
# marker is written only when the working tree matches the index — a
# partial staging proves the disk, not the commit, and earns no marker.
cd "$(git rev-parse --show-toplevel)" || exit 1
pnpm run gates || exit 1
if git diff --quiet; then
  git write-tree > "$(git rev-parse --git-dir)/meteo-gates-green"
fi
exit 0
