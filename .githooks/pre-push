#!/bin/sh
# The full local gate battery gates every push — a push deploys the site,
# and there is no CI behind it to catch what this misses. In an emergency
# `git push --no-verify` skips it; the battery still runs before every
# publish (Release boundaries in CONTRIBUTING.md).
cd "$(git rev-parse --show-toplevel)" || exit 1
exec pnpm run gates
